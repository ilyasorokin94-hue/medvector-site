# MedVector: основной адрес https://medvector.pro/
# med-vector.ru, med-vector.online и www-варианты ведут сюда 301-редиректом.
Options -Indexes
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

# типы файлов, которых нет в старых настройках Apache
AddType image/webp .webp
AddType font/woff2 .woff2
AddType video/mp4 .mp4
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} !^medvector\.pro$ [NC]
RewriteRule ^ https://medvector.pro%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://medvector.pro%{REQUEST_URI} [R=301,L]
</IfModule>

# Исходники, служебные файлы и превью для GitHub на сайте не нужны: если папку выложили целиком, отвечаем «не найдено».
<IfModule mod_alias.c>
RedirectMatch 404 ^/(src|_tools|node_modules|preview)(/|$)
RedirectMatch 404 ^/(package(-lock)?\.json|eleventy\.config\.js|README\.md)$
RedirectMatch 404 /\.(git|gitignore|nojekyll|env)
</IfModule>

<IfModule mod_headers.c>
# защита: браузер не угадывает тип файла, сайт нельзя встроить в чужую страницу, чужим сайтам уходит только адрес домена
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

# Кеш. Страницы браузер каждый раз сверяет с сервером, поэтому выкладка видна сразу.
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
# Стили и скрипт внутренних страниц подключаются с отпечатком содержимого (?v=…), их можно держать год.
<FilesMatch "^pages\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
# Остальные стили и скрипты, картинки: сутки, потом браузер сверяется с сервером.
<FilesMatch "^(?!pages\.).*\.(css|js|webp|jpg|jpeg|png|svg|ico)$">
Header set Cache-Control "public, max-age=86400"
</FilesMatch>
# Шрифты и видео меняются редко: месяц.
<FilesMatch "\.(woff2|mp4|webm)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
