{% extends "base.njk" %}

{% block main %}
{% import "blocks.njk" as b %}
{{ b.phero(hero, crumbs) }}

<section class="section" id="works">
  <div class="wrap">
    <div class="head-row">
      {{ b.head({ eyebrow: 'Примеры работ', title: 'Лендинги, сайты и карточки.' }) }}
    </div>
    <div class="filter" data-filter="works-grid" role="group" aria-label="Показать работы">
      <button type="button" data-kind="all" aria-pressed="true">Все</button>
      <button type="button" data-kind="direct" aria-pressed="false">Яндекс Директ</button>
      <button type="button" data-kind="site" aria-pressed="false">Сайты</button>
      <button type="button" data-kind="maps" aria-pressed="false">Карты</button>
    </div>
    <div class="works" id="works-grid">
{% for e in works %}
      {{ b.ex(e) }}
{% endfor %}
    </div>
  </div>
</section>

<section class="section section--alt" id="cases">
  <div class="wrap">
    {{ b.head({ eyebrow: 'Кейсы', title: 'Что было, что сделали, что изменилось.', lead: 'Так будут выглядеть наши кейсы. Пока цифры условные.' }) }}
    <div class="cases">
{% for c in cases %}
      {{ b.casecard(c) }}
{% endfor %}
    </div>
  </div>
</section>

<section class="section" id="template">
  <div class="wrap">
    {{ b.head(tplHead) }}
    <ol class="tpl">
{% for i in tpl %}
      <li><b>{{ i.b }}</b>{{ i.s | t | safe }}</li>
{% endfor %}
    </ol>
  </div>
</section>

{{ b.start(start) }}
{% endblock %}
