---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{# В карту попадают все страницы, кроме служебных: 404, «спасибо» и документы. #}
{% for p in collections.all | sort(false, false, 'url') %}
{% if p.url and p.url.endsWith('/') and p.url not in ['/spasibo/', '/politika/', '/soglasie/'] and p.data.sitemap != false %}
  <url><loc>{{ site.url }}{{ p.url }}</loc>{% if p.data.dateModified %}<lastmod>{{ p.data.dateModified }}</lastmod>{% endif %}</url>
{% endif %}
{% endfor %}
</urlset>
