---
{% extends "base.njk" %}

{% block main %}
{% import "blocks.njk" as b %}

<!-- ============ 1. ПЕРВЫЙ ЭКРАН ============ -->
{% call b.phero(hero, crumbs) %}
<div class="duo duo--site" data-tilt>
  {{ b.m_browser('site') }}
  {{ b.m_phone('site') }}
  {{ b.m_map() }}
  <span class="tag duo__demo">демо-макеты</span>
</div>
{% endcall %}

{{ b.anchors(anchors) }}

<!-- ============ 2. КОМУ ПОДХОДИТ ============ -->
<section class="section section--alt" id="fit">
  <div class="wrap">
    {{ b.head(fit) }}
    <div class="grid grid-4">
{% for f in fitItems %}
      <article class="card reveal"><span class="point__n">{{ loop.index }}</span><h3 class="h3">{{ f.h | t | safe }}</h3><p>{{ f.p | t | safe }}</p></article>
{% endfor %}
    </div>
    <p class="note">Если сайт и карточка уже сильные, а нужны пациенты на имплантацию и All-on-4, начните с <a href="{{ href('direct') }}">теста Яндекс Директа</a>.</p>
  </div>
</section>

<!-- ============ 3. АРЕНДА, ЗАКАЗ ИЛИ МЕДВЕКТОР ============ -->
<section class="section" id="compare">
  <div class="wrap">
    {{ b.head(compare) }}
    <div class="tbl-wrap">
      <table class="cmp cmp--stack">
        <caption class="sr-only">Сравнение способов получить сайт клиники</caption>
        <thead><tr><th scope="col">&nbsp;</th><th scope="col">Аренда шаблона</th><th scope="col">Сайт в студии</th><th scope="col" class="is-us">МедВектор</th></tr></thead>
        <tbody>
{% for r in compareRows %}
          <tr><th scope="row">{{ r[0] }}</th><td data-label="Аренда шаблона">{{ r[1] | t | safe }}</td><td data-label="Сайт в студии">{{ r[2] | t | safe }}</td><td class="is-us" data-label="МедВектор">{{ r[3] | t | safe }}</td></tr>
{% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ============ 4. ЧТО ВХОДИТ В САЙТ ============ -->
<section class="section section--alt" id="site">
  <div class="wrap">
    {{ b.head(siteHead) }}
    <div class="grid grid-3">
{% for g in siteGroups %}
      <article class="card reveal">
        <span class="point__n">{{ loop.index }}</span>
        <h3 class="h3">{{ g.h | t | safe }}</h3>
        <ul class="ticks ticks--sm">
{% for i in g.items %}
          <li>{{ i | t | safe }}</li>
{% endfor %}
        </ul>
      </article>
{% endfor %}
    </div>
  </div>
</section>

<!-- ============ 5. ЯНДЕКС КАРТЫ ============ -->
<section class="section" id="maps">
  <div class="wrap">
    <div class="panel">
      <div class="panel__grid">
        <div>
          <p class="eyebrow">{{ maps.eyebrow }}</p>
          <h2 class="h2">{{ maps.title | t | safe }}</h2>
          <p class="lead">{{ maps.lead | t | safe }}</p>
          <div class="panel__list">
{% for r in mapsRows %}
            <div class="panel__row"><i>{{ loop.index }}</i><div><b>{{ r.b | t | safe }}</b><span>{{ r.s | t | safe }}</span></div></div>
{% endfor %}
          </div>
        </div>
        <div class="panel__art">
          <div class="ba">
            <div class="ba__col"><span>До</span>{{ b.m_map({ weak: true }) }}</div>
            <div class="ba__col ba__col--after"><span>После</span>{{ b.m_map() }}</div>
          </div>
          <span class="tag tag--dark">пример, демо-карточка</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 6. ДРУГИЕ ПЛОЩАДКИ ============ -->
<section class="section section--alt" id="listings">
  <div class="wrap">
    {{ b.head(listings) }}
    <div class="grid grid-3">
{% for c in listingCards %}
      <article class="card reveal"><h3 class="h3">{{ c.h }}</h3><p>{{ c.p | t | safe }}</p></article>
{% endfor %}
    </div>
  </div>
</section>

<!-- ============ 7. ОТЗЫВЫ В БЕЛУЮ ============ -->
<section class="section" id="reviews">
  <div class="wrap">
    {{ b.head(reviews) }}
    <div class="grid grid-2">
      <div class="card reveal"><h3 class="h3">Чего не делаем</h3><ul class="crosses">{% for i in reviewsNo %}<li>{{ i | t | safe }}</li>{% endfor %}</ul></div>
      <div class="card card--blue reveal"><h3 class="h3">Как делаем</h3><ul class="ticks">{% for i in reviewsYes %}<li>{{ i | t | safe }}</li>{% endfor %}</ul></div>
    </div>
  </div>
</section>

<!-- ============ 8. АДМИНИСТРАТОРЫ ============ -->
<section class="section section--alt" id="admins">
  <div class="wrap">
    {{ b.head(admins) }}
    <div class="chips">
      <span class="chip">Скрипт ответа на звонок и заявку</span>
      <span class="chip">Просьба об отзыве после визита</span>
      <span class="chip">Мотивация за отзывы</span>
      <span class="chip">Проверка скорости ответа</span>
      <span class="chip">Отметки записей</span>
    </div>
  </div>
</section>

<!-- ============ 9. SEO И ВЕДЕНИЕ ============ -->
<section class="section" id="seo">
  <div class="wrap">
    {{ b.head(seo) }}
    <div class="grid grid-3">
{% for s in seoItems %}
      <article class="card reveal"><h3 class="h3">{{ s.h | t | safe }}</h3><p>{{ s.p | t | safe }}</p></article>
{% endfor %}
    </div>
    <p class="note">{{ seoNote | t | safe }}</p>
  </div>
</section>

<!-- ============ 10. ПЛАН 3 МЕСЯЦЕВ ============ -->
<section class="section section--alt" id="plan">
  <div class="wrap">
    {{ b.head(plan) }}
    <div class="stages">
{% for s in planItems %}
      <article class="stage">
        <p class="stage__n">{{ s.n }}</p>
        <h3>{{ s.h | t | safe }}</h3>
        <p>{{ s.p | t | safe }}</p>
        <div class="stage__bar" aria-hidden="true"><i style="--w: {{ s.w }}"></i></div>
      </article>
{% endfor %}
    </div>
  </div>
</section>

<!-- ============ 11. СТОИМОСТЬ ============ -->
