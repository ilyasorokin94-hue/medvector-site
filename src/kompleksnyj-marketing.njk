{% extends "base.njk" %}

{% block main %}
{% import "t.njk" as b %}
<!-- ============ 1. ПЕРВЫЙ ЭКРАН ============ -->
{{ b.phero(hero, crumbs) }}

<!-- ============ 2. ПАКЕТ НА 3 МЕСЯЦА: что входит и сколько стоит ============ -->
<section class="dark sheet" id="price" data-dark>
  <div class="wrap">
    {{ b.shead({ title: 'Стартовый пакет на три месяца. Сайт входит в цену.', note: 'Цена записана в договоре. Отдельно и напрямую клиника платит только подписку Яндекс Бизнеса и платные тарифы площадок, если решит их подключить.' }) }}
    <div class="pack">
      <div>
        <h3 class="pack__h">В первый месяц</h3>
        <ul class="spec">
{% for r in packRows %}
          <li class="reveal"><h4>{{ r[0] | t | safe }}</h4><p>{{ r[1] | t | safe }}</p>{% if r[2] %}<b>{{ r[2] | t | safe }}</b>{% endif %}</li>
{% endfor %}
        </ul>
      </div>
      <div>
        <h3 class="pack__h">Сколько это стоит</h3>
        <ol class="plan">
{% for p in plan %}
          <li class="reveal"><span class="plan__m">{{ p[0] }}</span><b class="plan__sum">{{ p[1] | t | safe }}</b><span class="plan__bar" style="--w: {{ p[3] }}" aria-hidden="true"></span><p>{{ p[2] | t | safe }}</p></li>
{% endfor %}
        </ol>
        <div class="pack__acts">
          <a href="#start" class="btn btn--light" data-magnetic data-pick="site">Обсудить маркетинг клиники</a>
        </div>
      </div>
    </div>
    <p class="after__why">После трёх месяцев ведение стоит те&nbsp;же 60&nbsp;000&nbsp;₽ в&nbsp;месяц, его можно остановить. Пока сайт не&nbsp;опубликован, оплату пакета можно вернуть. Сайт, домен и&nbsp;карточки оформлены на&nbsp;клинику и&nbsp;остаются у&nbsp;вас.</p>
  </div>
</section>

<!-- ============ 3. МАРКЕТОЛОГ, ПОДРЯДЧИКИ ИЛИ МЕДВЕКТОР ============ -->
<section class="sec sheet" id="compare">
  <div class="wrap">
    {{ b.shead({ title: 'Маркетолог в штате, несколько подрядчиков или одна команда.', note: 'Три способа вести маркетинг клиники. Названий компаний здесь нет.' }) }}
    <div class="cmp-wrap">
      <table class="cmp cmp--4">
        <caption class="sr">Сравнение способов вести маркетинг стоматологии</caption>
        <thead><tr><td></td><th scope="col">Маркетолог в штате</th><th scope="col">Несколько подрядчиков</th><th scope="col">МедВектор</th></tr></thead>
        <tbody>
{% for r in compareRows %}
          <tr><th scope="row">{{ r[0] }}</th><td data-label="Маркетолог в штате">{{ r[1] | t | safe }}</td><td data-label="Несколько подрядчиков">{{ r[2] | t | safe }}</td><td data-label="МедВектор">{{ r[3] | t | safe }}</td></tr>
{% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ============ 3а. КОМАНДА ============ -->
<section class="sec sec--fog" id="team">
  <div class="wrap">
    {{ b.shead({ title: 'Аутсорсинг маркетинга: команда вместо одного маркетолога.', note: 'С клиникой работают несколько специалистов, а общается с вами один менеджер.' }) }}
    <ul class="spec spec--sm spec--cols">
{% for r in team %}
      <li class="reveal"><h4>{{ r[0] | t | safe }}</h4><p>{{ r[1] | t | safe }}</p></li>
{% endfor %}
    </ul>
  </div>
</section>

<!-- ============ 3б. АУДИТ И СТРАТЕГИЯ ============ -->
<section class="sec" id="audit">
  <div class="wrap">
    {{ b.shead({ title: 'Начинаем с аудита и стратегии.', note: 'Сайт и карточки без плана дают красивую картинку, а не пациентов. Поэтому сначала разбираем клинику и соседей, это занимает 2 рабочих дня.' }) }}
    <ol class="incl__list">
{% for r in audit %}
      <li class="reveal"><h4>{{ r[0] | t | safe }}</h4><p>{{ r[1] | t | safe }}</p></li>
{% endfor %}
    </ol>
  </div>
</section>

<!-- ============ 4. ЧТО ВХОДИТ В САЙТ ============ -->
<section class="sec sec--fog" id="site">
  <div class="wrap">
    {{ b.shead({ title: 'Первый месяц: сайт клиники.', note: 'Сайт собираем в первый месяц пакета. Пример на картинке сделан для вымышленной клиники.' }) }}
    <div class="sitebox">
      <div class="sitebox__pic reveal">
        {{ b.a_browser('site') }}
        {{ b.a_phone('site') }}
      </div>
      <ol class="deflist">
{% for g in siteGroups %}
        <li class="reveal"><h3 class="h3">{{ g[0] | t | safe }}</h3><p>{{ g[1] | t | safe }}</p></li>
{% endfor %}
      </ol>
    </div>
    <p class="pack__own">Этапы работы, требования к медицинским сайтам и сравнение с шаблоном и студией: на&nbsp;странице <a href="{{ href('sites') }}">сайта для стоматологии</a>.</p>
  </div>
</section>

<!-- ============ 5. ЯНДЕКС КАРТЫ ============ -->
<section class="sec" id="maps">
  <div class="wrap">
    {{ b.shead({ title: 'Первый месяц: Яндекс Карты и площадки.', note: 'Человек ищет стоматологию рядом и сравнивает карточки. Карты мы знаем лучше всего остального и показываем, сколько звонков и маршрутов даёт карточка.' }) }}
    <div class="mapbox">
      <div class="mapbox__pic reveal">
        <figure><figcaption>До</figcaption>{{ b.a_map(true) }}</figure>
        <figure><figcaption>После</figcaption>{{ b.a_map() }}</figure>
        <p class="mapbox__demo"><span class="tag">Карточки на картинке сделаны для вымышленной клиники</span></p>
      </div>
      <ul class="spec spec--sm">
{% for r in mapsRows %}
        <li class="reveal"><h4>{{ r[0] | t | safe }}</h4><p>{{ r[1] | t | safe }}</p></li>
{% endfor %}
