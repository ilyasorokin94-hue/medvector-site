      </div>
      <p class="shead__note">Так будут выглядеть наши кейсы: с&nbsp;периодом, источником цифр и&nbsp;тем, что считаем записью. Пока это пример, данные условные.</p>
    </div>
{% for c in cases %}
    <article class="work reveal">
      <div class="work__head">
        <p class="work__meta">{{ loop.index | pad2 }}<span>{{ c.meta | join(' · ') }}</span><span class="tag">пример, данные условные</span></p>
        <h3 class="work__title">{{ c.title | t | safe }}</h3>
      </div>
      <div class="work__text">
        <p><b>Было.</b> {{ c.was | t | safe }}</p>
        <p><b>Сделали.</b> {{ c.did | t | safe }}</p>
