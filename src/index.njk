{% extends "base.njk" %}

{% block main %}
{% import "t.njk" as b %}
{% import "p.njk" as p %}
<!-- ============ 1. ПЕРВЫЙ ЭКРАН: слева карточка с основателем и двумя числами, справа заголовок, три канала и две кнопки ============ -->
<section class="band dark phr" id="intro">
  <div class="wrap">
    <div class="phr__grid">
      <div class="phr__media">
        <canvas class="orb phr__orb" data-orb="420" width="700" height="700" aria-hidden="true"></canvas>
{% if founderPhoto %}
        <img class="phr__photo" src="/assets/img/founder.webp" alt="Илья Сорокин, основатель МедВектора" width="800" height="800" fetchpriority="high">
        <div class="phr__float phr__float--a">{{ b.a_lead() }}</div>
        <div class="phr__float phr__float--b">{{ b.a_book() }}</div>
        <p class="phr__who"><b>Илья Сорокин</b>, основатель</p>
{% else %}
        <div class="phr__arts">{{ b.a_ad() }}{{ b.a_lead() }}{{ b.a_book() }}</div>
{% endif %}
        <div class="phr__stats">
          <div><b>8</b>лет<br>в&nbsp;маркетинге</div>
          <div><b>50+</b>клиник<br>в&nbsp;опыте команды</div>
        </div>
      </div>
      <div class="phr__text">
        <h1 class="h1">Медицинский маркетинг для стоматологий: <em>от&nbsp;запроса в&nbsp;Яндексе до&nbsp;записи к&nbsp;врачу</em></h1>
        <p class="phr__sub">Директ, сайт, Яндекс Карты и&nbsp;SEO в&nbsp;одних руках. Каждую неделю показываем, сколько стоили <b>заявка и&nbsp;запись</b>.</p>
        <ul class="chips" aria-label="Чем занимаемся">
          <li>Яндекс Директ</li>
          <li>Сайт и&nbsp;SEO</li>
          <li>Яндекс Карты</li>
        </ul>
        <div class="acts">
          <a href="#start" class="btn" data-magnetic>Обсудить клинику</a>
          <a href="{{ href('prices') }}" class="btn btn--out">Цены и&nbsp;условия</a>
        </div>
      </div>
    </div>
    <p class="phr__geo"><canvas class="orb" data-orb="70" width="60" height="60" aria-hidden="true"></canvas>Работаем с&nbsp;клиниками по&nbsp;всей России, удалённо</p>
  </div>
</section>

<!-- бегущая строка: первый тест Директа -->
<div class="tick">
  <div class="tick__run">
    <span>Первый тест в&nbsp;Директе <em>без комиссии агентства</em></span>
    <span>Депозит клиника вносит <em>Яндексу</em></span>
    <span>Запуск за&nbsp;<em>7&nbsp;рабочих дней</em></span>
  </div>
  <a class="btn btn--sm tick__btn" href="{{ href('direct') }}#price">Условия теста</a>
</div>

<!-- ============ 2. СЧИТАЕМ ДО ЗАПИСИ: слева текст и путь одной заявки, справа карточка с отчётом ============ -->
<section class="band band--fog" id="count">
  <div class="wrap">
    {{ p.head('Считаем *записи к врачу*, а не только клики и заявки') }}
    <div class="duo">
      <div class="duo__text">
        <p>Обычный отчёт подрядчика заканчивается на&nbsp;кликах и&nbsp;заявках. Что стало с&nbsp;человеком дальше, в&nbsp;нём не&nbsp;видно. <b>У&nbsp;нас видно.</b></p>
        {{ p.flow() }}
        <p>По&nbsp;каждой заявке понятно, с&nbsp;какого запроса пришёл человек, как быстро ему перезвонили и&nbsp;записался&nbsp;ли он на&nbsp;консультацию.</p>
      </div>
      <div class="repcard reveal">
        <p class="repcard__h">Недельный отчёт</p>
        {{ b.a_report() }}
      </div>
    </div>
    <p class="more"><a href="#start" class="btn" data-magnetic>Разобрать мою клинику</a></p>
  </div>
</section>

<!-- ============ 3. ПУТЬ ПАЦИЕНТА: пять строк сужаются книзу, справа карточка с кнопкой на цены ============ -->
<section class="band" id="how">
  <div class="wrap">
    {{ p.head('Путь пациента: пять шагов, *у&nbsp;каждого своя цифра* в отчёте') }}
    <div class="fun">
      <ol class="fun__rows">
{% for s in journey %}
        <li class="fun__row reveal" style="--i: {{ loop.index0 }}"><b>{{ s[0] | t | safe }}</b><small>{{ s[1] | t | safe }}</small><span class="fun__kpi">в&nbsp;отчёте <i>{{ s[2] | t | safe }}</i></span></li>
{% endfor %}
      </ol>
      <aside class="fun__side">
        <h3 class="h3">Для клиники: готовые сценарии без экспериментов за&nbsp;ваш счёт</h3>
        <p>Как рекламировать имплантацию и&nbsp;<span class="nw">All-on-4</span>, мы уже знаем: какие запросы приводят пациентов, что должно быть на&nbsp;странице и&nbsp;что спросит человек до&nbsp;записи.</p>
        <a href="{{ href('prices') }}" class="btn btn--wide">Цены на&nbsp;услуги</a>
        <small>Число заявок и&nbsp;записей заранее не&nbsp;обещаем: оно зависит от&nbsp;города, цен клиники и&nbsp;скорости ответа администратора.</small>
      </aside>
    </div>
  </div>
</section>

<!-- ============ 4. КОМПЛЕКСНЫЙ ПОДХОД: высокая карточка с образцами и четыре плитки, последняя тёмная ============ -->
<section class="band band--fog" id="approach">
  <div class="wrap">
    {{ p.head('Нас выбирают за *комплексный подход* к маркетингу клиники', '', true) }}
    <div class="apr">
      <div class="apr__pic" aria-hidden="true">{{ b.a_ad() }}{{ b.a_phone() }}{{ b.a_map() }}</div>
{% for a in approach %}
      <div class="card reveal{% if loop.last %} card--ink{% endif %}"><span class="num">{{ loop.index }}</span><p>{{ a | t | safe }}</p></div>
{% endfor %}
    </div>
    <p class="demo"><span class="tag">Объявление, страница и карточка на картинке сделаны для вымышленной клиники</span></p>
  </div>
</section>

<!-- ============ 5. СФЕРА И ЧЕТЫРЕ ЧИСЛА ============ -->
<section class="band dark" id="numbers">
  <div class="wrap sph">
    <canvas class="orb sph__orb" data-orb="620" width="900" height="900" aria-hidden="true"></canvas>
    <div>
      <h2 class="h2">Небольшая команда, в&nbsp;которой клинику ведёт <em>основатель, а&nbsp;не&nbsp;стажёр</em></h2>
      <dl class="nums">
        <div><dt>в&nbsp;маркетинге, из&nbsp;них 5–6 в&nbsp;медицине</dt><dd><span data-count="8">8</span><small>лет</small></dd></div>
        <div><dt>клиник в&nbsp;опыте основателя и&nbsp;команды</dt><dd><span data-count="50">50</span>+</dd></div>
        <div><dt>на&nbsp;разбор клиники и&nbsp;расчёт запуска</dt><dd><span data-count="2">2</span><small>рабочих дня</small></dd></div>
        <div><dt>от&nbsp;получения доступов до&nbsp;запуска рекламы</dt><dd><span data-count="7">7</span><small>рабочих дней</small></dd></div>
      </dl>
      <a href="#start" class="btn" data-magnetic>Начать с&nbsp;разбора</a>
    </div>
  </div>
</section>

<!-- ============ 6. РАБОТЫ: на этом месте встанут кейсы с видео. Пока образцы для вымышленной клиники ============ -->
<section class="band band--deep dark" id="works">
  <div class="wrap">
    {{ p.samples() }}
  </div>
</section>

<!-- ============ 7. НАПРАВЛЕНИЯ В СТОМАТОЛОГИИ ============ -->
<section class="band" id="who">
  <div class="wrap">
    {{ p.head('Основная специализация: *стоматологии*', '', true) }}
    {{ p.dirs(dirs, 'У каждой услуги свой пациент и свой канал. Справа видно, чем мы её продвигаем.') }}
  </div>
</section>

<!-- ============ 8. УСЛУГИ: сетка карточек и карточка «не знаете, с чего начать» ============ -->
<section class="band dark" id="services">
  <div class="wrap">
    {{ p.head('Полный набор услуг *для маркетинга клиники*. Начать можно с одной', '', true) }}
    <div class="svc">
      <a class="svc__c reveal" href="{{ href('direct') }}"><span class="svc__badge">Основное направление</span><span class="svc__go" aria-hidden="true"></span><h3>Яндекс Директ</h3><p>Реклама имплантации и&nbsp;<span class="nw">All-on-4</span> со&nbsp;своей страницей под каждую услугу.</p><p class="svc__price">Первый тест без комиссии агентства</p></a>
      <a class="svc__c reveal" href="{{ href('complex') }}"><span class="svc__go" aria-hidden="true"></span><h3>Комплексный маркетинг</h3><p>Сайт под&nbsp;ключ, Яндекс Карты, 2ГИС и&nbsp;ПроДокторов, SEO и&nbsp;отзывы одним пакетом.</p><p class="svc__price">80&nbsp;000&nbsp;₽ первый месяц, дальше 60&nbsp;000&nbsp;₽</p></a>
      <a class="svc__c reveal" href="{{ href('seo') }}"><span class="svc__go" aria-hidden="true"></span><h3>SEO</h3><p>Структура сайта, страницы услуг и&nbsp;статьи под запросы пациентов в&nbsp;поиске Яндекса.</p><p class="svc__price">Стоимость после разбора</p></a>
      <a class="svc__c reveal" href="{{ href('maps') }}"><span class="svc__go" aria-hidden="true"></span><h3>Яндекс Карты</h3><p>Карточка клиники с&nbsp;ценами, врачами и&nbsp;фото. Ответы на&nbsp;отзывы от&nbsp;имени клиники.</p><p class="svc__price">Стоимость после разбора</p></a>
      <a class="svc__c reveal" href="{{ href('sites') }}"><span class="svc__go" aria-hidden="true"></span><h3>Сайты и&nbsp;лендинги</h3><p>Сайт клиники под&nbsp;ключ или отдельная страница услуги для рекламы.</p><p class="svc__price">Стоимость после разбора</p></a>
      <div class="svc__c svc__ask reveal"><h3>Не знаете, <em>с&nbsp;чего начать?</em></h3><p>За&nbsp;2&nbsp;рабочих дня разберём клинику и&nbsp;скажем, какое направление даст результат первым.</p><a href="#start" class="btn btn--wide" data-pick="unsure">Заказать разбор</a></div>
    </div>
    <p class="svc__note">Продвижение в&nbsp;нейросетях готовим отдельной услугой. Рекламу в&nbsp;соцсетях не&nbsp;ведём.</p>
  </div>
</section>

<!-- ============ 9. КАК СТРОИМ МАРКЕТИНГ КЛИНИКИ: пять шагов, у каждого своя полоса ============ -->
<section class="band band--fog steps__top" id="steps">
  <div class="wrap">
    {{ p.head('Как мы строим маркетинг клиники: *пять шагов*') }}
  </div>
</section>
<nav class="sdots" aria-label="Шаги"></nav>

<section class="band band--fog step" id="step-1">
  <div class="wrap">
    <p class="step__k"><b>Шаг 1.</b> Разбираем клинику до&nbsp;старта</p>
    <div class="duo">
      <div class="duo__text">
        <h2 class="h2">За&nbsp;2&nbsp;рабочих дня говорим, <em>с&nbsp;какого направления начать</em></h2>
        <p>Смотрим сайт, карточку на&nbsp;Картах и&nbsp;рекламу, если она уже идёт. Директ не&nbsp;навязываем: если клинике некуда вести пациента, сначала делаем сайт и&nbsp;карточки.</p>
        <div class="pair">
          <div><h3>Клиника с&nbsp;опытом рекламы, заявки обрабатывают быстро</h3><p><small>Начинаем с</small><b>Яндекс Директа</b></p></div>
          <div><h3>Новая клиника или клиника без сильного сайта</h3><p><small>Начинаем с</small><b>комплексного маркетинга</b></p></div>
        </div>
      </div>
      <div class="doc reveal">
        <div class="doc__paper" aria-hidden="true"><b>Разбор клиники</b><span>Сайт <i>что мешает записи</i></span><span>Яндекс Карты <i>чего не хватает</i></span><span>Реклама <i>куда уходит бюджет</i></span><span>Депозит <i>расчёт для города</i></span><span>С чего начать <i>план</i></span></div>
        <p>Покажем разбор и&nbsp;скажем, с&nbsp;какого направления начать. Если видим риски для запуска, говорим о&nbsp;них прямо.</p>
      </div>
    </div>
  </div>
</section>

<section class="band step" id="step-2">
  <div class="wrap">
    <p class="step__k"><b>Шаг 2.</b> Делаем страницу под каждую услугу</p>
    <div class="duo">
      <div class="duo__text">
        <h2 class="h2">Одна услуга, <em>одна страница</em>: врач, этапы и&nbsp;полная цена</h2>
        <p>Человек ищет «all on 4 цена», а&nbsp;попадает на&nbsp;главную, где имплантация, детский приём и&nbsp;отбеливание вперемешку. Ответа он не&nbsp;находит и&nbsp;уходит. Поэтому реклама ведёт на&nbsp;страницу своей услуги.</p>
        <p>Страницу разрабатываем под вашу клинику, без шаблонов. Основной сайт клиники при этом не&nbsp;меняем.</p>
      </div>
      <div class="step__pic reveal">{{ b.a_browser('landing') }}{{ b.a_phone('allon4') }}</div>
    </div>
  </div>
</section>

<section class="band band--fog step" id="step-3">
  <div class="wrap">
    <p class="step__k"><b>Шаг 3.</b> Запускаем рекламу и&nbsp;считаем каждую заявку</p>
    <div class="duo">
      <div class="duo__text">
        <h2 class="h2">Убираем запросы, <em>которые не&nbsp;приводят пациентов</em></h2>
        <p>«Имплантация бесплатно», «по&nbsp;ОМС», «обучение имплантологии», «вакансии»: клиника платит за&nbsp;каждый такой переход. Каждую неделю вычищаем их и&nbsp;показываем в&nbsp;отчёте, что исключили.</p>
        <p>Имплантацию и&nbsp;<span class="nw">All-on-4</span> ведём разными кампаниями: у&nbsp;этих пациентов разный чек и&nbsp;разный срок решения.</p>
      </div>
      <div class="step__pic reveal">{{ b.a_query('all on 4 цена') }}{{ b.a_ad({ title: 'Все зубы на 4 имплантах', path: 'all-on-4', text: 'Хирург и ортопед на одной консультации. Цена по этапам.' }) }}</div>
    </div>
  </div>
</section>

<section class="band step" id="step-4">
  <div class="wrap">
    <p class="step__k"><b>Шаг 4.</b> Приводим в&nbsp;порядок Карты и&nbsp;работу с&nbsp;отзывами</p>
    <div class="duo">
      <div class="duo__text">
        <h2 class="h2">Карточка клиники <em>отвечает на&nbsp;вопросы пациента</em> ещё до&nbsp;звонка</h2>
        <p>Оформляем Яндекс Карты, 2ГИС и&nbsp;ПроДокторов: те&nbsp;же цены, врачи и&nbsp;адрес, что на&nbsp;сайте. Отвечаем на&nbsp;все отзывы от&nbsp;имени клиники.</p>
        <p>Отзывы не&nbsp;пишем и&nbsp;не&nbsp;покупаем, рейтинг не&nbsp;накручиваем. Даём администраторам сценарий, как попросить пациента об&nbsp;отзыве после визита.</p>
      </div>
      <div class="step__pic reveal"><figure><figcaption>До</figcaption>{{ b.a_map(true) }}</figure><figure><figcaption>После</figcaption>{{ b.a_map() }}</figure></div>
    </div>
  </div>
</section>

<section class="band band--fog step" id="step-5">
  <div class="wrap">
