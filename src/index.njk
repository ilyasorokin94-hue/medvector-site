{% for nn in c.nums %}
          <div><dt>{{ nn[1] }}</dt><dd>{{ nn[0] }}</dd></div>
{% endfor %}
        </dl>
        <p class="work__src">{{ c.src | t | safe }}</p>
      </div>
      <figure class="work__pic">
        {{ chart(c.chart) }}
        <figcaption>{{ c.chart.label }}. Пример, данные условные</figcaption>
