{% extends "base.njk" %}


{% macro chart(c) %}
{%- set lo = (c.pts | sort) | first -%}{%- set hi = (c.pts | sort) | last -%}
{%- set n = c.pts | length -%}
<svg class="chart" viewBox="0 0 1200 440" role="img" aria-label="{{ c.label }}: {{ c.pts | join(', ') }}. Пример, данные условные">
  <g class="chart__grid" aria-hidden="true">
{% for k in [0, 1, 2, 3] %}
    <line x1="40" x2="1160" y1="{{ 60 + k * 100 }}" y2="{{ 60 + k * 100 }}"/>
{% endfor %}
  </g>
  <path class="chart__line" pathLength="1" d="{% for v in c.pts %}{{ 'M' if loop.first else 'L' }}{{ (40 + loop.index0 * 1120 / (n - 1)) | round(1) }} {{ (360 - (v - lo) / (hi - lo) * 280) | round(1) }} {% endfor %}"/>
{% for v in c.pts %}
  {%- set x = (40 + loop.index0 * 1120 / (n - 1)) | round(1) -%}{%- set y = (360 - (v - lo) / (hi - lo) * 280) | round(1) %}
  <path class="chart__pt" style="--i: {{ loop.index0 }}" d="M{{ x - 9 }} {{ y }}h18M{{ x }} {{ y - 9 }}v18"/>
{% endfor %}
  <text class="chart__ax" x="40" y="420">{{ c.from }}</text>
  <text class="chart__ax" x="1160" y="420" text-anchor="end">{{ c.to }}</text>
</svg>
{% endmacro %}

{% block main %}
<!-- ============ 1. ПЕРВЫЙ ЭКРАН: заголовок лесенкой, из его стрелки начинается линия-вектор ============ -->
<section class="hero" id="intro">
  <div class="wrap">
    <p class="label hero__label">Маркетинг только для стоматологий</p>
    <h1 class="h1 hero__title">
      <span class="ln">Яндекс Директ, сайты</span>
      <span class="ln ln--in">и&nbsp;Яндекс Карты<span class="vec-arrow" data-vstart aria-hidden="true"><svg viewBox="0 0 160 40" preserveAspectRatio="none"><path d="M4 20H160"/><path class="vec-arrow__head" d="M144 6l16 14-16 14"/></svg></span></span>
      <span class="ln">для&nbsp;стоматологий.</span>
      <span class="ln ln--in2">Начать <em>бесплатно</em>.</span>
    </h1>
    <div class="hero__foot">
      <p class="hero__sub">Тестовый месяц рекламы без оплаты нашей работы или сайт под&nbsp;ключ бесплатно при старте на&nbsp;3&nbsp;месяца. Условия и&nbsp;цены видны сразу, до&nbsp;разговора с&nbsp;менеджером.</p>
      <div class="hero__acts">
        <a href="#start" class="btn" data-magnetic data-pick="direct">Запустить тест бесплатно <span class="btn__arr" aria-hidden="true">→</span></a>
        <a href="#start" class="link" data-pick="site">Получить сайт бесплатно</a>
      </div>
    </div>
  </div>
</section>

<!-- ============ 2. ТЁМНЫЙ ЭКРАН: одна фраза и две услуги ============ -->
<section class="dark sheet" id="services" data-dark>
  <div class="wrap">
    <p class="statement" data-fill>Клик ничего не&nbsp;значит, пока пациент не&nbsp;<em>записался</em>. Поэтому мы&nbsp;ведём каждое направление до&nbsp;записи и&nbsp;показываем, сколько она стоит.</p>
    <div class="shead shead--dark">
      <div>
        <p class="label">Две услуги</p>
        <h2 class="h2">Реклама или основа. У&nbsp;каждой свой бесплатный вход.</h2>
      </div>
      <p class="shead__note">Цены и&nbsp;условия видны сразу. Всё подробное на&nbsp;странице услуги, все условия повторяем в&nbsp;договоре.</p>
    </div>
    <div class="svc">
{% for s in services %}
      <article class="svc__card reveal">
        <svg class="svc__vec" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M0 20H586M572 8l14 12-14 12"/></svg>
        <p class="svc__n">{{ loop.index | pad2 }}<span>{{ s.kicker }}</span></p>
        <h3 class="svc__title">{{ s.title | t | safe }}</h3>
        <p class="svc__for">{{ s.for | t | safe }}</p>
        <p class="svc__free"><b>0&nbsp;₽</b><span>{{ s.free | t | safe }}</span></p>
        <dl class="svc__rows">
{% for r in s.rows %}
          <div><dt>{{ r[0] }}</dt><dd>{{ r[1] | t | safe }}</dd></div>
{% endfor %}
        </dl>
        <div class="svc__acts">
          <a href="#start" class="btn btn--line" data-pick="{{ 'direct' if s.key == 'direct' else 'site' }}">{{ s.cta }} <span class="btn__arr" aria-hidden="true">→</span></a>
          <a href="{{ href(s.key) }}" class="link link--light">{{ s.more }}</a>
        </div>
      </article>
{% endfor %}
    </div>
    <p class="svc__foot">Стоимость ведения Директа после теста называем на&nbsp;разборе.</p>
  </div>
</section>

<!-- ============ 3. ЧТО ВЫБРАТЬ: строки ============ -->
<section class="sec sheet" id="choose">
  <div class="wrap">
    <div class="shead">
      <div>
        <p class="label">Что выбрать</p>
        <h2 class="h2">С чего начать вашей <em>клинике</em>.</h2>
      </div>
      <p class="shead__note">Три ситуации, с&nbsp;которыми к&nbsp;нам приходят чаще всего. Если не&nbsp;уверены, разберём клинику и&nbsp;подскажем.</p>
    </div>
    <div class="rows">
{% for c in choose %}
      <a class="row reveal" href="{{ '#start' if c.to == 'start' else href(c.to) }}"{% if c.to == 'start' %} data-pick="unsure"{% endif %}>
        <span class="row__n">{{ loop.index | pad2 }}</span>
        <span class="row__if"><small>Если</small>{{ c.if | t | safe }}</span>
        <span class="row__then">{{ c.then | t | safe }}<small>{{ c.note | t | safe }}</small></span>
        <span class="row__go" aria-hidden="true">→</span>
      </a>
{% endfor %}
    </div>
  </div>
</section>

<!-- ============ 4. КАК НАЧИНАЕМ: линия проходит через четыре шага ============ -->
<section class="sec" id="how">
  <div class="wrap">
    <div class="shead">
      <div>
        <p class="label">Как начинаем</p>
        <h2 class="h2">От заявки до&nbsp;первого отчёта.</h2>
      </div>
      <p class="shead__note">Рекламу запускаем за&nbsp;7&nbsp;рабочих дней после получения доступов и&nbsp;согласования оффера.</p>
    </div>
    <ol class="steps">
{% for s in steps %}
      <li class="step reveal">
        <span class="step__dot" data-vpoint aria-hidden="true"></span>
        <span class="step__n">{{ loop.index | pad2 }}</span>
        <h3 class="h3">{{ s.title | t | safe }}</h3>
        <p>{{ s.text | t | safe }}</p>
      </li>
{% endfor %}
    </ol>
  </div>
</section>

<!-- ============ 5. КРУГ: растёт до тёмного экрана, внутри принципы ============ -->
<section class="circle" id="principles" aria-labelledby="principles-title">
  <div class="circle__track">
    <div class="circle__stage">
      <span class="circle__disc" aria-hidden="true"></span>
      <div class="circle__in">
        <p class="label">Как мы работаем</p>
        <h2 class="h2" id="principles-title">Четыре правила, которые <em>не&nbsp;меняются</em>.</h2>
      </div>
    </div>
  </div>
  <div class="dark circle__body" data-dark>
    <div class="wrap">
      <ol class="princ">
{% for p in principles %}
        <li class="reveal"><h3 class="h3">{{ p.title | t | safe }}</h3><p>{{ p.text | t | safe }}</p></li>
{% endfor %}
      </ol>
    </div>
    <p class="sr">Инструменты: Яндекс Директ, Метрика, Яндекс Карты, 2ГИС, ПроДокторов.</p>
    <div class="marquee">
      <div class="marquee__in" aria-hidden="true">
{% for k in [1, 2] %}
        <span>Яндекс Директ</span><span>Метрика</span><span>Яндекс Карты</span><span>2ГИС</span><span>ПроДокторов</span>
{% endfor %}
      </div>
    </div>
  </div>
</section>

<!-- ============ 6. КЕЙСЫ: заголовок слева, описание справа, график на всю ширину ============ -->
