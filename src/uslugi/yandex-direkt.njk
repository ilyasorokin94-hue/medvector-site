{% extends "base.njk" %}

{% block main %}
{% import "blocks.njk" as b %}
{{ b.hero(hero, crumbs) }}
{{ b.fit(fit) }}

<!-- офферы: две панели, как «С чего начать» на главной -->
<section class="section offers2" id="offers">
  <div class="wrap">
    {{ b.head(offers) }}
    <div class="ways ways--and">
      <article class="way way--ads">
        <h3 class="way__title">Имплантация</h3>
        <div class="way__q">Спрос массовый, конкуренция высокая. Выигрывает понятное предложение.</div>
        <ul class="ticks"><li>Лендинг с&nbsp;ценой, этапами лечения и&nbsp;врачами</li><li>Кампании по&nbsp;запросам об&nbsp;имплантации в&nbsp;вашем городе</li><li>Условия клиники на&nbsp;первом экране: рассрочка, сроки, консультация</li></ul>
        <p class="way__fit">Подробнее: <a href="{{ href('implant') }}">реклама имплантации</a>.</p>
      </article>
      <article class="way way--base">
        <h3 class="way__title">All-on-4</h3>
        <div class="way__q">Решение дорогое и&nbsp;долгое. Пациенту важны врач и&nbsp;консультация.</div>
        <ul class="ticks"><li>Лендинг объясняет метод простым языком</li><li>Заявка ведёт на&nbsp;консультацию с&nbsp;врачом</li><li>Кампании по&nbsp;запросам о&nbsp;восстановлении всех зубов</li></ul>
        <p class="way__fit">Подробнее: <a href="{{ href('allon4') }}">реклама All-on-4</a>.</p>
      </article>
    </div>
  </div>
</section>

{{ b.incl(incl) }}
{{ b.steps(steps) }}
{{ b.report(report) }}
{{ b.price(price) }}

<!-- почему только Яндекс -->
<section class="section why" id="why">
  <div class="wrap why__grid">
    <div>
      {{ b.head(why) }}
    </div>
    <div class="why__text">
{% for p in why.text %}
      <p>{{ p | t | safe }}</p>
{% endfor %}
      <div class="principles">
{% for s in why.stamps %}
        <span>{{ s }}</span>
{% endfor %}
      </div>
    </div>
  </div>
</section>

{{ b.related(related) }}
{{ b.qa({ title: "Вопросы о Директе.", lead: "Не нашли свой вопрос? Задайте его на диагностике." }, faq) }}
{{ b.diag(diag) }}
{% endblock %}
