<!DOCTYPE html>
<html lang="ru" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{% block base %}{% endblock %}
<!-- сайт в разработке: убрать noindex при запуске на боевом домене -->
<meta name="robots" content="noindex, nofollow">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="theme-color" content="#ffffff">
<meta name="format-detection" content="telephone=no">
{% if not noCanonical %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% endif %}
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">

<meta property="og:type" content="{{ 'article' if layout == 'article.njk' else 'website' }}">
{% if layout == 'article.njk' and datePublished %}
<meta property="article:published_time" content="{{ datePublished }}">
<meta property="article:modified_time" content="{{ dateModified or datePublished }}">
{% endif %}
<meta property="og:locale" content="ru_RU">
<meta property="og:site_name" content="МедВектор">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/og-cover.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">

<!-- шрифт Geologica, как на главной: только нужные начертания и буквы, кириллица и цифры нужны первому экрану -->
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/geologica-cyrillic-text.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/geologica-latin-text.woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/pages.css">
{% block preload %}{% endblock %}
<!-- блоки появляются по мере прокрутки; если скрипт страницы не загрузился за пять секунд, показываем всё сразу, как без скриптов -->
<script>document.documentElement.classList.replace('no-js', 'js'); setTimeout(function () { if (!window.MV) document.documentElement.classList.replace('js', 'no-js'); }, 5000);</script>

{% block jsonld %}
<script type="application/ld+json">
{{ jsonld(site, page, title, description, crumbs, service, faq, { headline: h1, published: datePublished, modified: dateModified } if layout == 'article.njk' and datePublished else null) | safe }}
</script>
{% endblock %}
</head>
<body class="pg{% if pick %} is-pick{% endif %}{% if bodyClass %} {{ bodyClass }}{% endif %}">
<a class="skip" href="#main">К содержимому</a>
{% include "header-t.njk" %}

<main id="main">
{% block main %}{% endblock %}
</main>

{% include "footer-t.njk" %}
{% if form != false %}
<!-- нижняя кнопка на телефоне -->
<a href="#start" class="mcta" data-magnetic><span>{{ mctaText or 'Разобрать клинику' }}</span></a>
{% endif %}

<script src="/assets/js/vendor/lenis.min.js" defer></script>
<script src="/assets/js/pages.js" defer></script>
</body>
</html>
