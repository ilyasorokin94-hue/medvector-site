<!DOCTYPE html>
<html lang="ru" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<!-- сайт в разработке: убрать noindex при запуске на боевом домене -->
<meta name="robots" content="noindex, nofollow">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="theme-color" content="#f7f2e9">
<meta name="format-detection" content="telephone=no">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% block base %}{% endblock %}
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">

<meta property="og:type" content="website">
<meta property="og:locale" content="ru_RU">
<meta property="og:site_name" content="МедВектор">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/og-cover.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">

{% block preload %}{% endblock %}
<!-- свои шрифты: два нужных для первого экрана грузятся заранее -->
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/oswald-600-cyrillic.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/cormorant-garamond-400-cyrillic.woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/style.css">
{% if not home %}
<link rel="stylesheet" href="/assets/css/pages.css">
{% endif %}
<script>document.documentElement.classList.replace('no-js', 'js');</script>

{% block jsonld %}
<script type="application/ld+json">
{{ jsonld(site, page, title, description, crumbs, service, faq) | safe }}
</script>
{% endblock %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<div class="grain" aria-hidden="true"></div>
<div class="cursor" aria-hidden="true"><i></i></div>

{% include "header.njk" %}

<main>
{% block main %}{% endblock %}
</main>

{% include "footer.njk" %}


<script src="/assets/js/main.js" defer></script>
</body>
</html>
