<!DOCTYPE html>
<html lang="ru" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{% block base %}{% endblock %}
<!-- сайт в разработке: убрать noindex при запуске на боевом домене -->
<meta name="robots" content="noindex, nofollow">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="theme-color" content="#ffffff">
<meta name="format-detection" content="telephone=no">
{% if not noCanonical %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% endif %}
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">

<meta property="og:type" content="website">
<meta property="og:locale" content="ru_RU">
<meta property="og:site_name" content="МедВектор">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/og-cover.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">

<!-- свои шрифты: два нужных для первого экрана грузятся заранее -->
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/onest-cyrillic-wght-normal.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/playfair-display-cyrillic-400-italic.woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/trajectory.css">
<!-- пробная упаковка: плотный формат поверх «Траектории» -->
<link rel="stylesheet" href="/assets/css/pack.css">
<script>document.documentElement.classList.replace('no-js', 'js');</script>

{% block jsonld %}
<script type="application/ld+json">
{{ jsonld(site, page, title, description, crumbs, service, faq) | safe }}
</script>
{% endblock %}
</head>
<body class="pk{% if bodyClass %} {{ bodyClass }}{% endif %}">
<a class="skip" href="#main">К содержимому</a>
{% include "header-p.njk" %}

<main id="main">
{% block main %}{% endblock %}
</main>

{% include "footer-p.njk" %}
{% if form != false %}
<!-- нижняя кнопка на телефоне -->
<a href="#start" class="mcta"><span>{{ mctaText or 'Оставить заявку' }}</span></a>
{% endif %}

<script src="/assets/js/vendor/lenis.min.js" defer></script>
<script src="/assets/js/trajectory.js" defer></script>
<script src="/assets/js/pack.js" defer></script>
</body>
</html>
