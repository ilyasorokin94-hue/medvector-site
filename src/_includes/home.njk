<!DOCTYPE html>
<html lang="ru" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<!-- сайт в разработке: убрать noindex при запуске на боевом домене -->
<meta name="robots" content="noindex, nofollow">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="theme-color" content="#000f40">
<meta name="format-detection" content="telephone=no">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">

<meta property="og:type" content="website">
<meta property="og:locale" content="ru_RU">
<meta property="og:site_name" content="МедВектор">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/og-cover.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">

<!-- свой шрифт Geologica, только нужные начертания и буквы: кириллица и цифры нужны первому экрану, грузятся заранее -->
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/geologica-cyrillic-text.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/geologica-latin-text.woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/home.css">
<!-- блоки появляются по мере прокрутки; если скрипт страницы не загрузился за пять секунд, показываем всё сразу, как без скриптов -->
<script>document.documentElement.classList.replace('no-js', 'js'); setTimeout(function () { if (!window.MV) document.documentElement.classList.replace('js', 'no-js'); }, 5000);</script>

<script type="application/ld+json">
{{ jsonld(site, page, title, description, crumbs, service, faq) | safe }}
</script>
</head>
<body>
<a class="skip" href="#main">К содержимому</a>
<!-- шапка: над тёмным первым экраном прозрачная с белым знаком, после прокрутки светлая -->
<header class="hdr hdr--over" id="top">
  <div class="hdr__in">
    <a href="#top" class="hdr__logo" aria-label="МедВектор, наверх страницы">
      <img class="lg-l" src="/assets/img/medvector-logo.webp" alt="МедВектор" width="440" height="93">
      <img class="lg-d" src="/assets/img/medvector-logo-w.webp" alt="" width="440" height="93">
    </a>
    <nav class="hdr__nav" aria-label="Основное меню">
      <div class="drop" data-drop>
        <button type="button" class="drop__btn" aria-expanded="false" aria-controls="drop-services">Услуги<span class="drop__ic" aria-hidden="true"></span></button>
        <div class="drop__panel" id="drop-services">
          <ul class="drop__list">
            <li><a href="#services"><b>Яндекс Директ</b><small>Первый тест без комиссии агентства</small></a></li>
            <li><a href="#services"><b>Комплексный маркетинг</b><small>Сайт, Карты, 2ГИС и&nbsp;ПроДокторов одним пакетом</small></a></li>
            <li><a href="#sites"><b>Сайты и&nbsp;лендинги</b><small>Сайт клиники или страница услуги для рекламы</small></a></li>
            <li><a href="#services"><b>Яндекс Карты и&nbsp;2ГИС</b><small>Карточка клиники, каталог услуг, ответы на&nbsp;отзывы</small></a></li>
            <li><a href="#services"><b>SEO</b><small>Рост в&nbsp;поиске по&nbsp;услугам в&nbsp;своём городе</small></a></li>
          </ul>
        </div>
      </div>
      <a href="#cases">Кейсы</a>
      <a href="#team">Об агентстве</a>
      <a href="#start">Контакты</a>
    </nav>
    <a href="#start" class="btn btn--sm hdr__cta" data-magnetic>Разобрать клинику</a>
    <button class="burger" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="mnav"><span></span><span></span></button>
  </div>
</header>

<!-- мобильное меню: тёмный экран, пункты крупно -->
<div class="mnav" id="mnav" inert>
  <nav class="mnav__nav" aria-label="Мобильное меню">
    <p class="mnav__h">Услуги</p>
    <ul class="mnav__sub">
      <li><a href="#services">Яндекс Директ</a></li>
      <li><a href="#services">Комплексный маркетинг</a></li>
      <li><a href="#sites">Сайты и&nbsp;лендинги</a></li>
      <li><a href="#services">Яндекс Карты и&nbsp;2ГИС</a></li>
      <li><a href="#services">SEO</a></li>
    </ul>
    <a href="#cases">Кейсы</a>
    <a href="#team">Об агентстве</a>
    <a href="#start">Контакты</a>
  </nav>
  <div class="mnav__foot">
    <a href="#start" class="btn btn--light">Разобрать клинику</a>
    <p>Санкт-Петербург. Работаем с&nbsp;клиниками по&nbsp;всей России.</p>
  </div>
</div>

<main id="main">
{{ content | safe }}
</main>

<footer class="ftr">
  <div class="wrap">
    <div class="ftr__top">
      <p class="ftr__say">Агентство маркетинга для стоматологий. Санкт-Петербург, работаем по&nbsp;всей России.</p>
      <nav class="ftr__col" aria-label="Услуги">
        <h2>Услуги</h2>
        <a href="#services">Яндекс Директ</a>
        <a href="#services">Комплексный маркетинг</a>
        <a href="#sites">Сайты и&nbsp;лендинги</a>
        <a href="#services">Яндекс Карты и&nbsp;2ГИС</a>
        <a href="#services">SEO</a>
      </nav>
      <nav class="ftr__col" aria-label="Агентство">
        <h2>Агентство</h2>
        <a href="#cases">Кейсы</a>
        <a href="#team">Об агентстве</a>
        <a href="#faq">Вопросы</a>
        <a href="#start">Оставить заявку</a>
      </nav>
    </div>
    <div class="ftr__mark">
      <img src="/assets/img/medvector-logo-inverse.webp" alt="МедВектор" width="720" height="255" loading="lazy">
    </div>
    <div class="ftr__bottom">
      <p>© {{ year }} МедВектор</p>
      <nav aria-label="Документы">
        <a href="{{ href('policy') }}">Политика обработки персональных данных</a>
        <a href="{{ href('consent') }}">Согласие на обработку данных</a>
      </nav>
    </div>
  </div>
</footer>

<script src="/assets/js/vendor/lenis.min.js" defer></script>
<script src="/assets/js/home.js" defer></script>
</body>
</html>
