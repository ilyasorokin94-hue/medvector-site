{# Общие блоки страниц. Тексты приходят из шапки файла страницы (front matter), оформление в assets/css/site.css.
   Фильтр t расставляет неразрывные пробелы и понимает **полужирный**.
   Макеты (объявление, телефон, браузер, карточка на Картах) нарисованы вёрсткой для вымышленной клиники
   и подписаны «демо»: настоящие лендинги и скриншоты встанут на их место, когда появятся. #}

{% macro crumbs(items) %}
<nav class="crumbs" aria-label="Хлебные крошки">
  <ol>
    <li><a href="/">Главная</a></li>
{% for c in items %}
    <li>{% if loop.last %}<span aria-current="page">{{ c.name }}</span>{% else %}<a href="{{ c.url }}">{{ c.name }}</a>{% endif %}</li>
{% endfor %}
  </ol>
</nav>
{% endmacro %}

{# ---------- заголовок секции ---------- #}
{% macro head(s, center=false) %}
<div class="head{% if center %} head--center{% endif %}">
{% if s.eyebrow %}
  <p class="eyebrow">{{ s.eyebrow }}</p>
{% endif %}
  <h2 class="h2">{{ s.title | t | safe }}</h2>
{% if s.lead %}
  <p class="lead">{{ s.lead | t | safe }}</p>
{% endif %}
</div>
{% endmacro %}

{# ---------- первый экран внутренней страницы; картинка передаётся через {% call %} ---------- #}
{% macro phero(h, crumbItems) %}
<section class="phero" id="intro">
  <div class="wrap phero__grid{% if not caller %} phero__grid--solo{% endif %}">
    <div class="phero__text">
      {{ crumbs(crumbItems) }}
{% if h.plaque %}
      <p class="plaque">{{ h.plaque | t | safe }}</p>
{% endif %}
      <h1 class="h1">{{ h.title | t | safe }}</h1>
      <p class="phero__lead">{{ h.lead | t | safe }}</p>
{% if h.facts %}
      <ul class="phero__facts">
{% for f in h.facts %}
        <li{% if loop.first and h.warmFirst %} class="is-warm"{% endif %}>{{ f | t | safe }}</li>
{% endfor %}
      </ul>
{% endif %}
{% if h.cta %}
      <div class="btns">
        <a href="#start" class="btn" data-magnetic{% if h.pick %} data-pick="{{ h.pick }}"{% endif %}{% if h.dir %} data-dir="{{ h.dir }}"{% endif %}>{{ h.cta }} <i aria-hidden="true">→</i></a>
{% if h.cta2 %}
        <a href="{{ h.cta2url }}" class="btn btn--ghost"{% if h.pick2 %} data-pick="{{ h.pick2 }}"{% endif %}{% if h.dir2 %} data-dir="{{ h.dir2 }}"{% endif %}>{{ h.cta2 }}</a>
{% endif %}
      </div>
{% endif %}
    </div>
{% if caller %}
    <div class="phero__art">{{ caller() }}</div>
{% endif %}
  </div>
</section>
{% endmacro %}

{# ---------- якорное меню страницы ---------- #}
{% macro anchors(items) %}
<nav class="anchors" aria-label="Разделы страницы">
  <div class="wrap anchors__in">
{% for a in items %}
    <a href="#{{ a[0] }}">{{ a[1] }}</a>
{% endfor %}
  </div>
</nav>
{% endmacro %}

{# ---------- макеты для вымышленной клиники ---------- #}
{% macro m_ad(o={}) %}
<div class="m-ad" aria-hidden="true">
  <div class="m-ad__q">{{ o.q or 'all on 4 цена' }}</div>
  <span class="m-ad__mark">Реклама</span>
  <span class="m-ad__title">{{ o.title or 'All-on-4: консультация хирурга и КТ' }}</span>
  <span class="m-ad__url">demo-klinika.example › {{ o.path or 'all-on-4' }}</span>
  <span class="m-ad__text">{{ o.text or 'Несъёмные зубы на 4 имплантах. Цена и этапы на сайте, рассрочка.' }}</span>
  <span class="m-ad__links">{% for l in (o.links or ['Цены', 'Врачи', 'Этапы', 'Записаться']) %}<span>{{ l }}</span>{% endfor %}</span>
  <span class="m-ad__warn">Имеются противопоказания. Необходима консультация специалиста.</span>
</div>
{% endmacro %}

{% macro m_phone(kind='allon4') %}
<div class="m-phone" aria-hidden="true">
  <div class="m-phone__screen">
    <div class="mini">
      <div class="mini__top"><span>Демо</span><small>☰</small></div>
{% if kind == 'implant' %}
      <div class="mini__hero"><b>Имплантация зуба под ключ</b><small>Имплант, формирователь и коронка: цена по этапам</small><span class="mini__btn">Рассчитать стоимость</span></div>
      <div class="mini__rows"><span class="mini__row">Цена по этапам</span><span class="mini__row">Импланты и гарантия</span><span class="mini__row">Если мало кости</span></div>
{% elif kind == 'site' %}
      <div class="mini__hero"><b>Стоматология рядом с домом</b><small>Лечение, имплантация, детский приём</small><span class="mini__btn">Записаться</span></div>
      <div class="mini__rows"><span class="mini__row">Услуги и цены</span><span class="mini__row">Врачи</span><span class="mini__row">Отзывы с площадок</span></div>
{% else %}
      <div class="mini__hero"><b>Все зубы на 4 имплантах</b><small>Консультация хирурга и ортопеда, КТ, план лечения</small><span class="mini__btn">Записаться на консультацию</span></div>
      <div class="mini__rows"><span class="mini__row">Кому подходит метод</span><span class="mini__row">Врач и его опыт</span><span class="mini__row">Цена и рассрочка</span></div>
{% endif %}
      <div class="mini__form"><span>Запись на консультацию</span><i></i><i></i></div>
    </div>
  </div>
</div>
{% endmacro %}

{% macro m_browser(kind='site') %}
<div class="m-browser" aria-hidden="true">
  <div class="m-browser__bar"><i></i><i></i><i></i><span class="m-browser__url">demo-klinika.example{% if kind == 'landing' %}/all-on-4{% endif %}</span></div>
  <div class="mini">
    <div class="mini__top"><span>Стоматология «Демо»</span><span class="mini__nav"><small>Услуги</small><small>Врачи</small><small>Цены</small><small>Контакты</small></span></div>
{% if kind == 'landing' %}
    <div class="mini__hero"><b>Несъёмные зубы на 4 имплантах</b><small>Хирург и ортопед на одной консультации, КТ в клинике</small><span class="mini__btn">Записаться на консультацию</span></div>
    <div class="mini__cards"><span>Этапы и сроки</span><span>Врач и опыт</span><span>Цена и рассрочка</span></div>
{% else %}
    <div class="mini__hero"><b>Стоматология для всей семьи</b><small>Лечение, имплантация, протезирование. Цены на сайте</small><span class="mini__btn">Записаться онлайн</span></div>
    <div class="mini__cards"><span>Имплантация</span><span>All-on-4</span><span>Коронки и виниры</span></div>
{% endif %}
  </div>
</div>
{% endmacro %}

{% macro m_map(o={}) %}
<div class="m-map{% if o.weak %} m-map--weak{% endif %}" aria-hidden="true">
  <div class="m-map__area"></div>
  <div class="m-map__body">
    <span class="m-map__name">Стоматология «Демо»</span>
{% if o.weak %}
    <span class="m-map__rate"><span class="m-map__stars">★★★☆☆</span> <b>3,9</b> · мало отзывов, ответов нет</span>
    <span class="m-map__tags"><span>Нет цен</span><span>2 фото</span></span>
{% else %}
    <span class="m-map__rate"><span class="m-map__stars">★★★★★</span> <b>4,9</b> · отзывы с ответами клиники</span>
    <span class="m-map__tags"><span>Цены</span><span>Врачи</span><span>Фото</span><span>Запись</span></span>
{% endif %}
    <span class="m-map__btns"><span>Маршрут</span><span>Позвонить</span><span>Сайт</span></span>
  </div>
</div>
{% endmacro %}

{# композиция первого экрана: реклама слева, сайт и Карты справа #}
{% macro art() %}
<div class="art" data-tilt>
  <span class="art__group-label art__label--ads">Яндекс Директ</span>
  <span class="art__group-label art__label--base">Сайт и Карты</span>
  {{ m_browser('site') }}
  {{ m_map() }}
  <svg class="art__vector" viewBox="0 0 200 120" aria-hidden="true"><path d="M6 110C60 104 120 70 178 18" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-dasharray="2 12"/><path d="M150 14l32-2-8 31" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {{ m_phone('allon4') }}
  {{ m_ad() }}
  <span class="tag art__demo">демо-макеты</span>
</div>
{% endmacro %}

{# ---------- карточка примера работы ---------- #}
{% macro ex(e, rv=true) %}
<article class="ex{% if rv %} reveal{% endif %}"{% if e.kind %} data-kind="{{ e.kind }}"{% endif %}>
  <div class="ex__pic">
    <span class="tag">пример</span>
{% if e.pic == 'phone' %}{{ m_phone(e.variant or 'allon4') }}{% elif e.pic == 'map' %}{{ m_map() }}{% elif e.pic == 'landing' %}{{ m_browser('landing') }}{% else %}{{ m_browser('site') }}{% endif %}
  </div>
  <p class="ex__kind">{{ e.label }}</p>
  <h3 class="ex__title">{{ e.title | t | safe }}</h3>
  <p class="ex__text">{{ e.text | t | safe }}</p>
</article>
{% endmacro %}

{# ---------- карточка кейса: всегда с периодом и источником цифр ---------- #}
{% macro casecard(c) %}
<article class="case reveal"{% if c.kind %} data-kind="{{ c.kind }}"{% endif %}>
  <div class="case__meta"><span class="tag tag--warm">пример, данные условные</span>{% for m in c.meta %}<span class="tag">{{ m }}</span>{% endfor %}</div>
  <h3 class="case__title">{{ c.title | t | safe }}</h3>
  <dl class="case__steps">
    <dt>Было</dt><dd>{{ c.was | t | safe }}</dd>
    <dt>Сделали</dt><dd>{{ c.did | t | safe }}</dd>
  </dl>
  <div class="case__nums">
{% for n in c.nums %}
    <div><b>{{ n[0] | t | safe }}</b><span>{{ n[1] | t | safe }}</span></div>
{% endfor %}
  </div>
  <p class="case__src">{{ c.src | t | safe }}</p>
</article>
{% endmacro %}

{# ---------- кто ведёт: основатель и роли ---------- #}
{% macro team(t) %}
<section class="section{% if t.alt %} section--alt{% endif %}" id="{{ t.id or 'team' }}">
  <div class="wrap team">
    <div class="founder reveal">
      <div class="photo-ph" role="img" aria-label="Место для фото основателя"><span class="tag">фото основателя</span></div>
      <div class="founder__card"><b>Илья Сорокин</b><span>Основатель МедВектора. Лично ведёт запуск каждого направления</span></div>
    </div>
    <div class="team__text">
      <p class="eyebrow">{{ t.eyebrow or 'Кто ведёт' }}</p>
      <h2 class="h2">{{ t.title | t | safe }}</h2>
      <p class="lead">{{ t.lead | t | safe }}</p>
      <div class="team__facts">
        <div><b>8 лет</b><span>в маркетинге, из них 5–6 в медицине</span></div>
        <div><b>50+</b><span>клиник в опыте команды</span></div>
        <div><b>1</b><span>ниша: только стоматологии</span></div>
      </div>
{% if t.roles != false %}
      <div class="roles">
        <div class="role"><i aria-hidden="true"></i><div><b>Директолог</b><span>кампании, чистка запросов, отчёт</span></div></div>
        <div class="role"><i aria-hidden="true"></i><div><b>SEO-специалист</b><span>структура сайта, страницы и статьи</span></div></div>
        <div class="role"><i aria-hidden="true"></i><div><b>Специалист по Картам</b><span>карточки, площадки, отзывы</span></div></div>
        <div class="role"><i aria-hidden="true"></i><div><b>Разработчик</b><span>сайты, лендинги, формы и учёт</span></div></div>
      </div>
{% endif %}
{% if t.more %}
      <p><a class="more" href="{{ href('about') }}">{{ t.more }}</a></p>
{% endif %}
    </div>
  </div>
</section>
{% endmacro %}

{# ---------- вопросы: раскрывающийся список ---------- #}
{% macro qa(q, items) %}
<section class="section{% if q.alt %} section--alt{% endif %}" id="{{ q.id or 'faq' }}">
  <div class="wrap qa">
    <div class="qa__head">
      <p class="eyebrow">{{ q.eyebrow or 'Вопросы' }}</p>
      <h2 class="h2">{{ q.title | t | safe }}</h2>
{% if q.lead %}
      <p class="lead">{{ q.lead | t | safe }}</p>
{% endif %}
    </div>
    <div class="qa__list">
{% for f in items %}
      <details class="qa__item"{% if loop.first %} open{% endif %}>
        <summary>{{ f.q | t | safe }}<i aria-hidden="true"></i></summary>
        <div class="qa__a"><p>{{ f.a | t | safe }}</p></div>
      </details>
{% endfor %}
    </div>
  </div>
</section>
{% endmacro %}

{# ---------- заявка: одна форма на весь сайт с выбором услуги ---------- #}
{% macro start(d={}) %}
<section class="section start" id="start">
  <div class="wrap">
    <div class="start__panel">
      <div class="start__text">
        <p class="eyebrow">{{ d.eyebrow or 'Начать бесплатно' }}</p>
        <h2 class="h2">{{ (d.title or 'Оставьте заявку: разберём клинику и посчитаем запуск.') | t | safe }}</h2>
        <p class="lead">{{ (d.lead or 'За 2 рабочих дня посмотрим сайт, карточку на Картах и рекламу, если она уже идёт. Скажем, с чего начать: с теста Директа или с сайта и Карт.') | t | safe }}</p>
        <ul class="ticks">
{% for i in (d.items or ['Тест Директа: 0 ₽ за нашу работу, вы платите только бюджет Яндексу', 'Сайт под ключ: 0 ₽ при старте комплексного маркетинга на 3 месяца', 'Если реклама пока не окупится, скажем об этом сразу']) %}
          <li>{{ i | t | safe }}</li>
{% endfor %}
        </ul>
        <p class="start__promise">{{ (d.promise or 'Заявка ни к чему не обязывает. Ответим в рабочее время, уточним задачу и назовём срок разбора.') | t | safe }}</p>
      </div>
      <form class="form" novalidate action="#" aria-label="Заявка">
        <fieldset class="form__choice">
          <legend>Что хотите запустить</legend>
          <div class="form__opts">
            <label class="form__opt"><input type="radio" name="service" value="direct"{% if d.pick != 'site' %} checked{% endif %}><span>Тест Директа<small>0 ₽ за работу</small></span></label>
            <label class="form__opt"><input type="radio" name="service" value="site"{% if d.pick == 'site' %} checked{% endif %}><span>Сайт и Карты<small>сайт бесплатно</small></span></label>
            <label class="form__opt"><input type="radio" name="service" value="unsure"><span>Пока не знаю<small>подскажем</small></span></label>
          </div>
        </fieldset>
        <label class="fld form__dir">Направление
          <select name="direction">
            <option value="all-on-4"{% if d.dir == 'all-on-4' %} selected{% endif %}>All-on-4, полное восстановление</option>
            <option value="implant"{% if d.dir == 'implant' %} selected{% endif %}>Имплантация</option>
            <option value="running">Реклама уже идёт, нужен разбор</option>
            <option value="other">Другое направление</option>
          </select>
        </label>
        <div class="form__row">
          <label class="fld">Имя<input type="text" name="name" autocomplete="name" enterkeyhint="next" required></label>
          <label class="fld">Телефон или Telegram<input type="text" name="contact" autocomplete="tel" enterkeyhint="next" required></label>
        </div>
        <div class="form__row">
          <label class="fld">Город<input type="text" name="city" autocomplete="address-level2" enterkeyhint="next" required></label>
          <label class="fld">Сайт или карточка на Картах <small>если есть</small><input type="text" name="site" inputmode="url" autocomplete="url" placeholder="Ссылка" enterkeyhint="done"></label>
        </div>
        <label class="form__consent"><input type="checkbox" name="consent" required> <span>Даю <a href="{{ href('consent') }}">согласие на обработку персональных данных</a> на условиях <a href="{{ href('policy') }}">политики</a></span></label>
        <button class="btn" type="submit">{{ d.button or 'Отправить заявку' }} <i aria-hidden="true">→</i></button>
        <p class="form__after">Ответим в рабочее время. Без рассылок и навязчивых звонков.</p>
        <p class="form__ok" role="status">Спасибо! Сайт в разработке: заявка пока никуда не отправлена.</p>
      </form>
    </div>
  </div>
</section>
{% endmacro %}
