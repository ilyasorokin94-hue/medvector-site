<!-- ============ ШАПКА «Траектория»: логотип, «Услуги» списком, три пункта, одна кнопка ============ -->
{% set services = [
  ['direct', 'Яндекс Директ', 'Первый тест без комиссии агентства'],
  ['complex', 'Комплексный маркетинг', 'Сайт, Карты, SEO и отзывы одним пакетом'],
  ['seo', 'SEO', 'Страницы услуг и статьи под запросы пациентов'],
  ['maps', 'Яндекс Карты', 'Карточка клиники и ответы на отзывы'],
  ['sites', 'Сайты и лендинги', 'Сайт клиники или страница услуги для рекламы']
] %}
<header class="hdr" id="top">
  <div class="hdr__in">
    <a href="/" class="hdr__logo" aria-label="МедВектор, на главную"{% if home %} aria-current="page"{% endif %}>
      <img src="/assets/img/medvector-logo.webp" alt="МедВектор" width="440" height="93">
    </a>
    <nav class="hdr__nav" aria-label="Основное меню">
      <div class="drop{% if section == 'direct' or section == 'complex' %} is-current{% endif %}" data-drop>
        <button type="button" class="drop__btn" aria-expanded="false" aria-controls="drop-services">Услуги<span class="drop__ic" aria-hidden="true"></span></button>
        <div class="drop__panel" id="drop-services">
          <ul class="drop__list">
{% for s in services %}
            <li><a href="{{ href(s[0]) }}"{% if section == s[0] %} aria-current="page"{% endif %}><b>{{ s[1] }}</b><small>{{ s[2] }}</small></a></li>
{% endfor %}
          </ul>
        </div>
      </div>
      <a href="{{ href('cases') }}"{% if section == 'cases' %} aria-current="page"{% endif %}>Кейсы</a>
      <a href="{{ href('about') }}"{% if section == 'about' %} aria-current="page"{% endif %}>Об агентстве</a>
      <a href="{{ href('contacts') }}#contacts"{% if section == 'contacts' %} aria-current="page"{% endif %}>Контакты</a>
    </nav>
    <a href="{{ '#start' if form != false else '/#start' }}" class="btn btn--sm hdr__cta" data-magnetic>{{ ctaText or 'Начать бесплатно' }}</a>
    <button class="burger" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="mnav"><span></span><span></span></button>
  </div>
</header>

<!-- мобильное меню: тёмный экран, услуги списком, остальные пункты крупно -->
<div class="mnav" id="mnav" inert>
  <nav class="mnav__nav" aria-label="Мобильное меню">
    <p class="mnav__h">Услуги</p>
    <ul class="mnav__sub">
{% for s in services %}
      <li><a href="{{ href(s[0]) }}">{{ s[1] }}</a></li>
{% endfor %}
    </ul>
    <a href="{{ href('cases') }}">Кейсы</a>
    <a href="{{ href('about') }}">Об агентстве</a>
    <a href="{{ href('contacts') }}#contacts">Контакты</a>
  </nav>
  <div class="mnav__foot">
    <a href="{{ '#start' if form != false else '/#start' }}" class="btn btn--light">{{ ctaText or 'Начать бесплатно' }}</a>
    <p>Агентство медицинского маркетинга. Основная специализация: стоматологии. Работаем по&nbsp;всей России.</p>
  </div>
</div>
