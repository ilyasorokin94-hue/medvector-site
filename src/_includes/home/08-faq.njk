<!-- «Колесо»: колесо из первого варианта сайта. Список вопросов раскрывается на узком экране и без скриптов, на широком из него собирается колесо -->
<section class="sec" id="faq" data-line="light">
  <div class="sec__body q1">
    <div class="wrap">
      <i data-vp class="vp vp--xl"></i>
      <div class="sh">
        <div>
          <p class="label" data-rv="fade">Вопросы</p>
          <h2 class="h2 rvh"><span class="ln" style="--l:0"><span>Спрашивают</span></span> <span class="ln" style="--l:1"><span>до договора</span></span></h2>
        </div>
        <p class="sh__note" data-rv style="--d:2">Если вашего вопроса здесь нет, задайте его на разборе клиники.</p>
      </div>
      <div class="qa" data-wheel>
{% for f in faq %}
        <details class="qa__item" name="faq"{% if loop.first %} open{% endif %}><summary><span class="qa__q">{{ f.q }}</span><span class="qa__ic" aria-hidden="true"></span></summary><div class="qa__a"><p>{{ f.a }}</p></div></details>
{% endfor %}
      </div>
      <div class="wheel">
        <div class="wheel__dial">
          <canvas class="wheel__orb" data-orb="380" aria-hidden="true"></canvas>
          <div class="wheel__ring">
            <i aria-hidden="true"></i><i aria-hidden="true"></i>
            <div class="wheel__tabs" role="tablist" aria-label="Вопросы" aria-orientation="vertical">
{# вопросы стоят на кольце через 26 градусов; вторая половина списка уходит вверх от первого, дальше двух шагов вопрос скрыт -#}
{% for f in faq %}
{% set k = loop.index0 if loop.index0 < faq.length / 2 else loop.index0 - faq.length %}
              <button type="button" class="wheel__q{% if k > 2 or k < -2 %} is-far{% endif %}" role="tab" id="wq-{{ loop.index0 }}" aria-controls="wheel-panel" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %} style="--a:{{ k * 26 }}deg">{{ f.short }}</button>
{% endfor %}
            </div>
          </div>
          <span class="wheel__ptr" aria-hidden="true"></span>
          <p class="wheel__count" aria-hidden="true"><b>1</b><span>из {{ faq.length }}</span></p>
        </div>
        <div class="wheel__panel" role="tabpanel" id="wheel-panel" tabindex="0" aria-labelledby="wq-0">
          <h3 class="wheel__title">{{ faq[0].q }}</h3>
          <div class="wheel__a"><p>{{ faq[0].a }}</p></div>
          <div class="wheel__nav"><button type="button" class="wheel__btn" data-step="-1" aria-label="Предыдущий вопрос"></button><button type="button" class="wheel__btn wheel__btn--next" data-step="1" aria-label="Следующий вопрос"></button></div>
        </div>
      </div>
      <i data-vp class="vp vp--lb"></i>
    </div>
  </div>
</section>
