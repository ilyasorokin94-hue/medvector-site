{# Страница услуги, собранная из блоков. Тексты и порядок блоков задаются в шапке файла страницы (sections).
   Виды блоков: loss, spec, steps, deflist, cmp, yesno, qrows, pack, links. Оформление прежнее, «Траектория». #}
{% extends "base.njk" %}

{% block main %}
{% import "t.njk" as b %}
{{ b.phero(hero, crumbs) }}

{% for s in sections %}
<section class="sec{% if s.fog %} sec--fog{% endif %}{% if loop.first %} sheet{% endif %}"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="wrap">
    {{ b.shead({ title: s.title, note: s.note }) }}
{% if s.type == 'loss' %}
    <ol class="loss">
{% for r in s.items %}
      <li class="reveal">
        <div class="loss__what"><h3 class="h3">{{ r.title | t | safe }}</h3><p>{{ r.ex | t | safe }}</p></div>
        <p class="loss__fix"><small>{{ s.fixLabel or 'Что делаем' }}</small>{{ r.fix | t | safe }}</p>
      </li>
{% endfor %}
    </ol>
{% elif s.type == 'spec' %}
    <ul class="spec spec--sm">
{% for r in s.items %}
      <li class="reveal"><h4>{{ r[0] | t | safe }}</h4><p>{{ r[1] | t | safe }}</p></li>
{% endfor %}
    </ul>
{% elif s.type == 'steps' %}
    <ol class="incl__list{% if s.items.length == 3 %} incl__list--3{% endif %}">
{% for r in s.items %}
      <li class="reveal">{% if r[2] %}<span class="incl__n">{{ r[0] }}</span><h4>{{ r[1] | t | safe }}</h4><p>{{ r[2] | t | safe }}</p>{% else %}<h4>{{ r[0] | t | safe }}</h4><p>{{ r[1] | t | safe }}</p>{% endif %}</li>
{% endfor %}
    </ol>
{% elif s.type == 'deflist' %}
    <ol class="deflist">
{% for r in s.items %}
      <li class="reveal"><h3 class="h3">{{ r[0] | t | safe }}</h3><p>{{ r[1] | t | safe }}</p></li>
{% endfor %}
    </ol>
{% elif s.type == 'cmp' %}
    <div class="cmp-wrap">
      <table class="cmp{% if s.cols.length == 3 %} cmp--4{% endif %}">
        <caption class="sr">{{ s.caption or s.title }}</caption>
        <thead><tr><td></td>{% for c in s.cols %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
        <tbody>
{% for r in s.rows %}
          <tr><th scope="row">{{ r[0] | t | safe }}</th>{% for c in s.cols %}<td data-label="{{ c }}">{{ r[loop.index] | t | safe }}</td>{% endfor %}</tr>
{% endfor %}
        </tbody>
      </table>
    </div>
{% elif s.type == 'yesno' %}
    <div class="yesno">
      <div class="yesno__col">
        <h3 class="pack__h">{{ s.noTitle or 'Чего не делаем' }}</h3>
        <ul class="plist plist--lg plist--no">
{% for i in s.no %}
          <li class="reveal"><span>{{ i | t | safe }}</span></li>
{% endfor %}
        </ul>
      </div>
      <div class="yesno__col">
        <h3 class="pack__h">{{ s.yesTitle or 'Как делаем' }}</h3>
        <ul class="plist plist--lg">
{% for i in s.yes %}
          <li class="reveal"><span>{{ i | t | safe }}</span></li>
{% endfor %}
        </ul>
      </div>
    </div>
{% elif s.type == 'qrows' %}
    <ul class="qrows">
{% for g in s.items %}
      <li class="reveal"><h4>{{ g[0] | t | safe }}</h4><p class="qrows__q">{{ g[1] | t | safe }}</p><p class="qrows__a">{{ g[2] | t | safe }}</p></li>
{% endfor %}
    </ul>
{% elif s.type == 'pack' %}
    <div class="pack">
      <div>
        <h3 class="pack__h">{{ s.listTitle }}</h3>
        <ul class="plist plist--lg">
{% for n in s.list %}
          <li class="reveal"><span>{{ n | t | safe }}</span></li>
{% endfor %}
        </ul>
      </div>
      <div>
        <h3 class="pack__h">{{ s.termsTitle }}</h3>
        <dl class="terms{% if not s.bigFirst %} terms--plain{% endif %}">
{% for r in s.terms %}
          <div><dt>{{ r[0] }}</dt><dd>{{ r[1] | t | safe }}</dd></div>
{% endfor %}
        </dl>
{% if s.cta %}
        <div class="pack__acts">
          <a href="#start" class="btn" data-magnetic{% if s.pick %} data-pick="{{ s.pick }}"{% endif %}>{{ s.cta }}</a>
        </div>
{% endif %}
      </div>
    </div>
{% elif s.type == 'links' %}
    <ol class="deflist">
{% for r in s.items %}
      <li class="reveal"><h3 class="h3"><a class="link" href="{{ r[2] }}">{{ r[0] | t | safe }}</a></h3><p>{{ r[1] | t | safe }}</p></li>
{% endfor %}
    </ol>
{% endif %}
{% if s.own %}
    <p class="pack__own">{{ s.own | t | safe }}{% if s.ownLink %} <a href="{{ s.ownLink[1] }}">{{ s.ownLink[0] | t | safe }}</a>.{% endif %}</p>
{% endif %}
  </div>
</section>

{% endfor %}
{% if faq %}
<section class="sec{% if sections.length % 2 == 0 %} sec--fog{% endif %}" id="faq">
  <div class="wrap">
    {{ b.shead({ title: faqTitle or 'Вопросы и ответы.', note: 'Не нашли ответ? Задайте вопрос в заявке, ответим в рабочее время.' }) }}
    {{ b.qa(faq) }}
  </div>
</section>
{% endif %}

{{ b.start(start or {}) }}
{% endblock %}
