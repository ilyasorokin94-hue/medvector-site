<!-- ============ ШАПКА: логотип, четыре пункта меню, связь и одна кнопка ============ -->
<header class="header" id="top">
  <div class="header__in">
    <a href="/" class="logo" aria-label="МедВектор, на главную"{% if home %} aria-current="page"{% endif %}>
      <img src="/assets/img/medvector-logo.webp" alt="МедВектор" width="440" height="93">
    </a>
    <nav class="nav" aria-label="Основное меню">
      <a href="{{ href('direct') }}" class="nav__link{% if section == 'direct' %} is-active{% endif %}"{% if section == 'direct' %} aria-current="page"{% endif %}>Яндекс Директ</a>
      <a href="{{ href('complex') }}" class="nav__link{% if section == 'complex' %} is-active{% endif %}"{% if section == 'complex' %} aria-current="page"{% endif %}>Сайт и Карты</a>
      <a href="{{ href('cases') }}" class="nav__link{% if section == 'cases' %} is-active{% endif %}"{% if section == 'cases' %} aria-current="page"{% endif %}>Кейсы</a>
      <a href="{{ href('about') }}" class="nav__link{% if section == 'about' %} is-active{% endif %}"{% if section == 'about' %} aria-current="page"{% endif %}>О нас</a>
    </nav>
    <div class="header__contacts">
      {% include "contact-icons.njk" %}
    </div>
    <a href="{{ '#start' if form != false else '/#start' }}" class="btn" data-magnetic>Начать бесплатно</a>
    <button class="burger" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="mnav"><span></span><span></span><span></span></button>
  </div>
  <span class="progress" aria-hidden="true"><i></i></span>
</header>

<!-- мобильное меню на весь экран -->
<div class="mnav" id="mnav" inert>
  <nav aria-label="Мобильное меню">
    <a href="{{ href('direct') }}"><small>01</small>Яндекс Директ</a>
    <a href="{{ href('complex') }}"><small>02</small>Сайт и Карты</a>
    <a href="{{ href('cases') }}"><small>03</small>Кейсы</a>
    <a href="{{ href('about') }}"><small>04</small>О нас и контакты</a>
  </nav>
  <a href="{{ '#start' if form != false else '/#start' }}" class="btn btn--block">Начать бесплатно</a>
  <p class="mnav__note">Тест Директа без оплаты нашей работы или сайт бесплатно при старте на 3 месяца.</p>
  <div class="mnav__contacts">
    {% include "contact-icons.njk" %}
  </div>
</div>
