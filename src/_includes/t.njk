{# Хлебные крошки и образцы для вымышленной клиники. Секции страниц лежат в src/_includes/looks.
   Фильтр t расставляет неразрывные пробелы и понимает **полужирный**.
   Образцы (запрос, объявление, страница на телефоне, заявка, запись, карточка на Картах, отчёт) нарисованы вёрсткой
   для вымышленной клиники и подписаны «образец»: настоящие скриншоты встанут на их место, когда появятся. #}

{# ---------- хлебные крошки ---------- #}
{% macro crumbs(items) %}
<nav class="crumbs" aria-label="Хлебные крошки">
  <ol>
    <li><a href="/">Главная</a></li>
{% for c in items %}
    <li>{% if loop.last %}<span aria-current="page">{{ c.name }}</span>{% else %}<a href="{{ c.url }}">{{ c.name }}</a>{% endif %}</li>
{% endfor %}
  </ol>
</nav>
{% endmacro %}

{# ---------- образцы для вымышленной клиники ---------- #}
{% macro a_query(q='имплантация зубов цена') %}
<div class="art art--query" aria-hidden="true"><i class="art__glass"></i><span class="art__typed" data-type="{{ q }}">{{ q }}</span></div>
{% endmacro %}

{% macro a_ad(o={}) %}
<div class="art art--ad" aria-hidden="true">
  <span class="art__mark">Реклама</span>
  <b>{{ o.title or 'Имплантация зубов под ключ' }}</b>
  <span class="art__url">demo-klinika.ru › {{ o.path or 'implantaciya' }}</span>
  <span class="art__txt">{{ o.text or 'Имплант, формирователь и коронка. Цена по этапам, рассрочка.' }}</span>
  <span class="art__warn">Имеются противопоказания, нужна консультация специалиста</span>
</div>
{% endmacro %}

{% macro a_phone(kind='implant') %}
<div class="art art--phone" aria-hidden="true">
  <div class="pn">
    <span class="pn__top"><i></i>Стоматология «Демо»</span>
{% if kind == 'allon4' %}
    <b>Все зубы на 4 имплантах</b>
    <small>Хирург и ортопед на одной консультации, КТ в клинике</small>
    <span class="pn__btn">Записаться на консультацию</span>
    <span class="pn__row">Кому подходит метод</span><span class="pn__row">Врач и его опыт</span><span class="pn__row">Этапы и сроки</span><span class="pn__row">Полная цена и рассрочка</span>
{% elif kind == 'site' %}
    <b>Стоматология рядом с домом</b>
    <small>Лечение, имплантация, детский приём. Цены на сайте</small>
    <span class="pn__btn">Записаться</span>
    <span class="pn__row">Услуги и цены</span><span class="pn__row">Врачи</span><span class="pn__row">Отзывы с площадок</span><span class="pn__row">Как добраться</span>
{% else %}
    <b>Имплантация под ключ</b>
    <small>Имплант, формирователь и коронка: цена по этапам</small>
    <span class="pn__btn">Записаться</span>
    <span class="pn__row">Цена по этапам</span><span class="pn__row">Врач и его опыт</span><span class="pn__row">Если мало кости</span><span class="pn__row">Рассрочка</span>
{% endif %}
  </div>
</div>
{% endmacro %}

{% macro a_lead() %}
<div class="art art--lead" aria-hidden="true">
  <span class="art__top">Новая заявка<span>12:04</span></span>
  <b>Имплантация, консультация</b>
  <span class="art__txt">Поиск, запрос «имплантация зубов цена»</span>
</div>
{% endmacro %}

{% macro a_book() %}
<div class="art art--book" aria-hidden="true">
  <span class="art__top">Запись<span>отметил администратор</span></span>
  <b>Чт, 15:30</b>
  <span class="art__txt">Консультация хирурга</span>
</div>
{% endmacro %}

{% macro a_browser(kind='site') %}
<div class="art art--browser" aria-hidden="true">
  <span class="br__bar"><i></i><i></i><i></i><span>demo-klinika.ru{% if kind == 'landing' %}/all-on-4{% endif %}</span></span>
  <span class="br__nav"><b>Стоматология «Демо»</b><span>Услуги</span><span>Врачи</span><span>Цены</span><span>Контакты</span></span>
{% if kind == 'landing' %}
  <span class="br__h">Несъёмные зубы на 4 имплантах</span>
  <span class="br__p">Хирург и ортопед на одной консультации, КТ в клинике</span>
  <span class="br__btn">Записаться на консультацию</span>
  <span class="br__cards"><span>Этапы и сроки</span><span>Врач и опыт</span><span>Цена и рассрочка</span></span>
{% else %}
  <span class="br__h">Стоматология для всей семьи</span>
  <span class="br__p">Лечение, имплантация, протезирование. Цены на сайте</span>
  <span class="br__btn">Записаться онлайн</span>
  <span class="br__cards"><span>Имплантация</span><span>All-on-4</span><span>Коронки и виниры</span></span>
{% endif %}
</div>
{% endmacro %}

{% macro a_map(weak=false) %}
<div class="art art--map{% if weak %} art--weak{% endif %}" aria-hidden="true">
  <span class="mp__area"><i></i></span>
  <b>Стоматология «Демо»</b>
{% if weak %}
  <span class="mp__rate">Цен нет, отзывы без ответа</span>
  <span class="mp__tags"><span>Нет цен</span><span>2 фото</span></span>
{% else %}
  <span class="mp__rate">Цены и врачи указаны, клиника отвечает на отзывы</span>
  <span class="mp__tags"><span>Цены</span><span>Врачи</span><span>Фото</span><span>Запись</span></span>
{% endif %}
  <span class="mp__btns"><span>Маршрут</span><span>Позвонить</span><span>Сайт</span></span>
</div>
{% endmacro %}

{# недельный отчёт: образец для вымышленной клиники, депозит 150 000 ₽ в месяц #}
{% macro a_report() %}
<div class="rep">
  <div class="rep__head"><b>Отчёт за неделю, имплантация</b><span class="tag">образец, клиника вымышленная</span></div>
  <dl class="rep__kpis">
    <div><dt>заявок</dt><dd>9</dd></div>
    <div><dt>записей на консультацию</dt><dd>4</dd></div>
    <div><dt>цена записи</dt><dd>9&nbsp;375&nbsp;₽</dd></div>
  </dl>
  <section class="rep__scroll" tabindex="0" aria-label="Таблица отчёта">
    <table class="rep__table">
      <caption class="sr">Образец недельного отчёта, клиника вымышленная</caption>
      <thead><tr><th scope="col">Канал</th><th scope="col">Расход</th><th scope="col">Переходы</th><th scope="col">Заявки</th><th scope="col">Цена заявки</th><th scope="col">Записи</th></tr></thead>
      <tbody>
        <tr><th scope="row">Поиск</th><td>27&nbsp;300&nbsp;₽</td><td>105</td><td>7</td><td>3&nbsp;900&nbsp;₽</td><td>3</td></tr>
        <tr><th scope="row">Рекламная сеть</th><td>10&nbsp;200&nbsp;₽</td><td>290</td><td>2</td><td>5&nbsp;100&nbsp;₽</td><td>1</td></tr>
      </tbody>
      <tfoot><tr><th scope="row">Итого</th><td>37&nbsp;500&nbsp;₽</td><td>395</td><td>9</td><td>4&nbsp;167&nbsp;₽</td><td>4</td></tr></tfoot>
    </table>
  </section>
  <ul class="rep__notes">
    <li><b>Что сделали.</b> Убрали 23 запроса без намерения лечиться: «бесплатно», «по ОМС», «обучение», «вакансии».</li>
    <li><b>Что дальше.</b> Проверяем второй вариант первого экрана на странице услуги.</li>
    <li><b>От клиники.</b> Отметки записей из CRM, за неделю 2 визита.</li>
  </ul>
</div>
{% endmacro %}

