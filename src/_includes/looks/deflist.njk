{# Крупные пункты: заголовок и абзац. Данные: s.items [[заголовок, текст]]. #}
{% import "looks/_c.njk" as c %}

{# «Список»: номер, крупный заголовок слева, текст справа #}
{% macro list(s) %}
<section{{ c.attrs(s, 'lk-deflist-list') }}>
  <div class="wrap">
    {{ c.head(s) }}
    <ol class="dl">
{% for r in s.items %}
      <li class="dl__i" data-rv><span class="dl__n">{{ loop.index }}</span><h3 class="h3">{{ r[0] | t | safe }}</h3><p>{{ r[1] | t | safe }}</p></li>
{% endfor %}
    </ol>
    {{ c.own(s) }}
  </div>
</section>
{% endmacro %}

{# «По клику»: крупные заголовки во всю ширину, текст раскрывается по нажатию; первый пункт открыт #}
{% macro fold(s) %}
<section{{ c.attrs(s, 'lk-deflist-fold') }}>
  <div class="wrap">
    {{ c.head(s) }}
    <div class="df">
{% for r in s.items %}
      <details class="df__i" data-rv{% if loop.first %} open{% endif %}>
        <summary class="df__s"><h3 class="df__h">{{ r[0] | t | safe }}</h3><span class="df__ic" aria-hidden="true"></span></summary>
        <p class="df__a">{{ r[1] | t | safe }}</p>
      </details>
{% endfor %}
    </div>
    {{ c.own(s) }}
  </div>
</section>
{% endmacro %}

{# «Лесенка»: пункты по очереди сдвинуты влево и вправо, заголовок крупным шрифтом, текст под ним #}
{% macro zigzag(s) %}
<section{{ c.attrs(s, 'lk-deflist-zigzag') }}>
  <div class="wrap">
    {{ c.head(s) }}
    <ul class="dz">
{% for r in s.items %}
      <li class="dz__i" data-rv>
        <h3 class="dz__h">{{ r[0] | t | safe }}</h3>
        <p class="dz__p">{{ r[1] | t | safe }}</p>
      </li>
{% endfor %}
    </ul>
    {{ c.own(s) }}
  </div>
</section>
{% endmacro %}

{# «Сбоку»: заголовок секции держится слева при прокрутке, пункты справа на вертикальной линии #}
{% macro side(s) %}
<section{{ c.attrs(s, 'lk-deflist-side') }}>
  <div class="wrap ds">
    <div class="ds__side">
{% if s.label %}
      <p class="label" data-rv="fade">{{ s.label }}</p>
{% endif %}
      <h2 class="h2 ds__h" data-rv>{{ s.title | nodot | t | safe }}</h2>
{% if s.note %}
      <p class="ds__note" data-rv style="--d:1">{{ s.note | t | safe }}</p>
{% endif %}
    </div>
    <div class="ds__main">
      <ul class="ds__list">
{% for r in s.items %}
        <li class="ds__i" data-rv>
          <h3 class="ds__t">{{ r[0] | t | safe }}</h3>
          <p>{{ r[1] | t | safe }}</p>
        </li>
{% endfor %}
      </ul>
      {{ c.own(s) }}
    </div>
  </div>
</section>
{% endmacro %}

{# «Тёмные плитки»: тёмная полоса, пункты плитками в две колонки под тонкими рамками #}
{% macro panels(s) %}
<section class="sec sec--dark dark lk-deflist-panels"{% if s.id %} id="{{ s.id }}"{% endif %} data-sec="{{ s.type }}">
  <div class="wrap">
    {{ c.head(s) }}
    <ul class="dp">
{% for r in s.items %}
      <li class="dp__i" data-rv style="--d: {{ loop.index0 % 2 }}">
        <h3 class="dp__h">{{ r[0] | t | safe }}</h3>
        <p>{{ r[1] | t | safe }}</p>
      </li>
{% endfor %}
    </ul>
    {{ c.own(s) }}
  </div>
</section>
{% endmacro %}
