{# Пункты с пояснением. Данные: s.items [[заголовок, текст]]. #}
{% import "looks/_c.njk" as c %}

{# «Сетка»: две колонки пунктов под тонкими линиями #}
{% macro grid(s) %}
<section{{ c.attrs(s, 'lk-spec-grid') }}>
  <div class="wrap">
    {{ c.head(s) }}
    <ul class="sg">
{% for r in s.items %}
      <li data-rv style="--d:{{ loop.index0 % 2 }}"><h3 class="sg__h">{{ r[0] | t | safe }}</h3><p>{{ r[1] | t | safe }}</p></li>
{% endfor %}
    </ul>
    {{ c.own(s) }}
  </div>
</section>
{% endmacro %}
