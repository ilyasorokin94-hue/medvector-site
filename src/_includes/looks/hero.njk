{# Первый экран внутренней страницы. Данные: s.h (title, lead, cta, pick, cta2, cta2url, pick2, dir2, facts), s.crumbs, s.url, s.page.
   Рисунок к услуге выбирается по адресу страницы (art). Фото для «Фото» берётся из src/_data/pageart.json: страница передаёт s.art = pageart[адрес], нужно s.art.hero = { src, alt, h },
   файлы src-640.webp, src-1000.webp, src-1600.webp; без фото рисуется спокойная схема в цветах сайта. #}
{% import "looks/_c.njk" as c %}

{% macro acts(h, light=false) %}
{% if h.cta %}
<div class="ph__acts">
  <a href="#start" class="btn{% if light %} btn--light{% endif %}" data-magnetic{% if h.pick %} data-pick="{{ h.pick }}"{% endif %}>{{ h.cta }}</a>
{% if h.cta2 %}
  <a href="{{ h.cta2url }}" class="link{% if light %} link--light{% endif %}"{% if h.pick2 %} data-pick="{{ h.pick2 }}"{% endif %}{% if h.dir2 %} data-dir="{{ h.dir2 }}"{% endif %}>{{ h.cta2 }}</a>
{% endif %}
</div>
{% endif %}
{% endmacro %}

{% macro facts(h) %}
{% if h.facts %}
<ul class="terms ph__facts">
{% for f in h.facts %}
  <li data-rv style="--d:{{ loop.index + 2 }}"><b class="num">{{ f[0] | t | safe }}</b><span>{{ f[1] | t | safe }}</span></li>
{% endfor %}
</ul>
{% endif %}
{% endmacro %}

{# строка-заглушка текста в рисунке: ширина в процентах #}
{% macro ln(w, cls='') %}<i class="ha__l{% if cls %} {{ cls }}{% endif %}" style="--w:{{ w }}%"></i>{% endmacro %}

