{# «Шрифт»: белый экран, крупный заголовок, пояснение и кнопки справа, три факта под линией #}
{% macro type(s) %}
{% set h = s.h %}
<section class="ph ph--type"{% if s.id %} id="{{ s.id }}"{% endif %} data-sec="hero">
  <div class="wrap">
    {{ c.crumbs(s.crumbs) }}
    <h1 class="ph__h" data-rv>{{ h.title | t | safe }}</h1>
    <div class="ph__foot">
      <p class="ph__lead" data-rv style="--d:1">{{ h.lead | t | safe }}</p>
      <div data-rv style="--d:2">{{ acts(h) }}</div>
    </div>
    {{ facts(h) }}
  </div>
</section>
{% endmacro %}

{# «Сцена»: слева заголовок и кнопки, справа рисунок именно этой услуги: объявление, карточка на Картах, профиль врача, ответ нейросети #}
{% macro scene(s) %}
{% set h = s.h %}{% set k = (s.url or '') | replace('/', '') %}
{{ useLook('hero', 'art') }}
<section class="ph phs"{% if s.id %} id="{{ s.id }}"{% endif %} data-sec="hero">
  <div class="wrap">
    <div class="phs__grid">
      <div class="phs__text">
        {{ c.crumbs(s.crumbs) }}
        <h1 class="ph__h phs__h" data-rv>{{ h.title | t | safe }}</h1>
        <p class="ph__lead phs__lead" data-rv style="--d:1">{{ h.lead | t | safe }}</p>
        <div data-rv style="--d:2">{{ acts(h) }}</div>
      </div>
      <div class="phs__stage">{{ art(k) }}</div>
    </div>
    {{ facts(h) }}
  </div>
</section>
{% endmacro %}

{# «Фото»: тёмный экран во всю ширину под прозрачной шапкой, фото клиники, заголовок внизу. Без фото рисуется схема-радар #}
{% macro photo(s) %}
{% set h = s.h %}{% set img = (s.art or {}).hero %}
<section class="ph phf sec--dark dark{% if img %} phf--img{% endif %}"{% if s.id %} id="{{ s.id }}"{% endif %} data-sec="hero"{% if not PICK %} data-over{% endif %}>
  <div class="phf__bg">
{% if img %}
    <img class="phf__img" src="{{ img.src }}-1000.webp" srcset="{{ img.src }}-640.webp 640w, {{ img.src }}-1000.webp 1000w, {{ img.src }}-1600.webp 1600w" sizes="100vw" width="1600" height="{{ img.h or 1000 }}" alt="{{ img.alt }}" fetchpriority="high" decoding="async">
{% else %}
    <svg class="phf__radar" viewBox="0 0 600 600" aria-hidden="true"><circle cx="300" cy="300" r="90" /><circle cx="300" cy="300" r="170" /><circle cx="300" cy="300" r="250" /><circle cx="300" cy="300" r="290" class="phf__ring" /><path d="M300 10 V590 M10 300 H590" /><g class="phf__pts"><circle cx="420" cy="180" r="4" /><circle cx="160" cy="236" r="4" /><circle cx="388" cy="452" r="4" /><circle cx="214" cy="420" r="4" /><circle cx="520" cy="330" r="4" /></g><circle cx="300" cy="300" r="8" class="phf__me" /></svg>
{% endif %}
  </div>
  <div class="wrap phf__grid">
    {{ c.crumbs(s.crumbs) }}
    <h1 class="ph__h phf__h" data-rv>{{ h.title | t | safe }}</h1>
    <div class="phf__say">
      <p class="ph__lead" data-rv style="--d:1">{{ h.lead | t | safe }}</p>
      <div data-rv style="--d:2">{{ acts(h, true) }}</div>
    </div>
    {{ facts(h) }}
  </div>
</section>
{% endmacro %}

{# «Панель»: синяя панель на белом. Слева заголовок и кнопки, справа белая карточка с фактами крупно; без фактов в карточке пояснение #}
{% macro panel(s) %}
{% set h = s.h %}
<section class="ph phn"{% if s.id %} id="{{ s.id }}"{% endif %} data-sec="hero">
  <div class="wrap">
    {{ c.crumbs(s.crumbs) }}
    <div class="phn__box{% if not h.facts %} phn__box--nofacts{% endif %}">
      <div class="phn__main">
        <h1 class="ph__h phn__h" data-rv>{{ h.title | t | safe }}</h1>
{% if h.facts %}
        <p class="ph__lead phn__lead" data-rv style="--d:1">{{ h.lead | t | safe }}</p>
{% endif %}
        <div data-rv style="--d:2">{{ acts(h) }}</div>
      </div>
      <div class="phn__card" data-rv="scale" style="--d:2">
{% if h.facts %}
        <ul class="phn__facts">
{% for f in h.facts %}
          <li><b class="num">{{ f[0] | t | safe }}</b><span>{{ f[1] | t | safe }}</span></li>
{% endfor %}
        </ul>
{% else %}
        <p class="phn__say">{{ h.lead | t | safe }}</p>
{% endif %}
      </div>
    </div>
  </div>
</section>
{% endmacro %}

{# «Плакат»: заголовок по центру во всю ширину, под ним рисунок услуги широкой полосой, факты в конце #}
{% macro poster(s) %}
{% set h = s.h %}{% set k = (s.url or '') | replace('/', '') %}
{{ useLook('hero', 'art') }}
<section class="ph php"{% if s.id %} id="{{ s.id }}"{% endif %} data-sec="hero">
  <div class="wrap">
    {{ c.crumbs(s.crumbs) }}
    <div class="php__head">
      <h1 class="ph__h php__h" data-rv>{{ h.title | t | safe }}</h1>
      <p class="ph__lead php__lead" data-rv style="--d:1">{{ h.lead | t | safe }}</p>
      <div class="php__acts" data-rv style="--d:2">{{ acts(h) }}</div>
    </div>
    <div class="php__band">{{ art(k) }}</div>
    {{ facts(h) }}
  </div>
</section>
{% endmacro %}
