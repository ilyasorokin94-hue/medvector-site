{# Статья блога: текст в теле файла страницы, вопросы и ссылка на услугу в шапке. #}
{% extends "base.njk" %}

{% block main %}
{% import "t.njk" as b %}
<section>
  <div class="wrap">
    <article class="prose prose--article">
      {{ b.crumbs(crumbs) }}
      <h1>{{ h1 | t | safe }}</h1>
      <p class="prose__lead">{{ lead | t | safe }}</p>
{% if updated %}
      <p class="prose__meta">Обновлено: {{ updated }}</p>
{% endif %}
{% set toc = content | h2list %}
{% if toc.length > 2 %}
      <nav class="prose__toc" aria-label="Содержание статьи">
        <p>В статье</p>
        <ul>
{% for i in toc %}
          <li><a href="#{{ i.id }}">{{ i.text | safe }}</a></li>
{% endfor %}
        </ul>
      </nav>
{% endif %}
      {{ content | h2ids | safe }}
{% if legal %}
      <p class="prose__note">Статья описывает общие требования и не заменяет консультацию юриста. Документы меняются: перед запуском сверяйтесь с действующей редакцией.</p>
{% endif %}
{% if next %}
      <p class="prose__next">{{ next.text | t | safe }} <a href="{{ next.url }}">{{ next.link | t | safe }}</a>.</p>
{% endif %}
{% set rel = related(collections.all, page.url, topic) %}
{% if rel.length %}
      <nav class="prose__rel" aria-label="Читайте также">
        <h2>Читайте также</h2>
        <ul>
{% for a in rel %}
          <li><a href="{{ a.url }}">{{ a.data.h1 | t | safe }}</a></li>
{% endfor %}
        </ul>
      </nav>
{% endif %}
    </article>
  </div>
</section>

{% if faq %}
<section class="sec sec--fog" id="faq">
  <div class="wrap">
    {{ b.shead({ title: 'Короткие ответы.', note: 'Не нашли ответ? Задайте вопрос в заявке, ответим в рабочее время.' }) }}
    {{ b.qa(faq) }}
  </div>
</section>
{% endif %}

{{ b.start(start or { pick: 'unsure' }) }}
{% endblock %}
