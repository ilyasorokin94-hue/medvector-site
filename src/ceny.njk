{% extends "base.njk" %}

{% block main %}
{% import "t.njk" as b %}
{% import "p.njk" as p %}
<!-- ============ 1. ЗАГОЛОВОК И ТРИ ТАРИФА ============ -->
<section class="band dark pin pin--c" id="intro">
  <div class="wrap">
    {{ b.crumbs(crumbs) }}
    <h1 class="h1">Тарифы и&nbsp;цены</h1>
    <p class="pin__lead">Рекламный бюджет клиника вносит Яндексу напрямую. Ниже цена нашей работы и&nbsp;всё, что в&nbsp;неё входит.</p>
  </div>
</section>
<section class="band band--flush dark" id="tariffs">
  <div class="wrap">
    <div class="trfs">
{% for c in tariffs %}
      {{ p.tariff(c) }}
{% endfor %}
    </div>
  </div>
</section>

<!-- ============ 2. ЧТО МОЖНО ЗАКАЗАТЬ ОТДЕЛЬНО: оглавление с номерами ============ -->
<section class="band band--flush dark" id="extra-index">
  <div class="wrap">
    <div class="idx">
      <h2>Каждую услугу можно заказать отдельно:</h2>
      <ol>
{% for e in extra %}
        <li><a href="#{{ e.id }}">{{ e.tab | t | safe }}</a></li>
{% endfor %}
      </ol>
    </div>
  </div>
</section>

<!-- ============ 3. ОТДЕЛЬНЫЕ УСЛУГИ ============ -->
<section class="band band--deep dark" id="extra">
  <div class="wrap">
    {{ p.head('Отдельные услуги', 'Стоимость зависит от того, что у клиники уже сделано. Называем её после разбора.') }}
    <div class="trfs">
{% for e in extra %}
      {{ p.tariff({ id: e.id, tab: e.tab, groups: e.groups, priceLabel: e.priceLabel or 'Стоимость:', price: e.price or 'после разбора клиники', url: href(e.url) if e.url else '', button: e.button, pick: e.pick }) }}
{% endfor %}
    </div>
  </div>
</section>

<!-- ============ 4. ЧТО ОСТАЁТСЯ У КЛИНИКИ ============ -->
<section class="band" id="own">
  <div class="wrap">
    {{ p.head('Что оформлено на клинику *при любом тарифе*', '', true) }}
    {{ p.rows([
      ['Рекламный кабинет и Метрика', 'Оформлены на клинику с первого дня. Кампании, объявления и статистика остаются у вас.'],
      ['Сайт, домен и хостинг', 'Сайт с полными правами передаём после оплаты стартового пакета. Абонентской платы за него нет.'],
      ['Карточки на Картах и площадках', 'Аккаунты заведены на клинику. Доступы у вас с первого дня.']
    ]) }}
  </div>
</section>

<!-- ============ 5. ВОПРОСЫ О ЦЕНАХ ============ -->
<section class="band band--fog" id="faq">
  <div class="wrap">
    {{ p.head('Вопросы *о ценах*') }}
    {{ b.qa(faq) }}
  </div>
</section>

{{ b.start({ title: 'Не знаете, какой тариф выбрать? Разберём клинику и скажем.', pick: 'unsure' }) }}
{% endblock %}
